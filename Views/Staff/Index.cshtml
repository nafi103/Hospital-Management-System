@model IEnumerable<HospitalManagementSystem.Models.User>

@{
    ViewData["Title"] = "Staff Directory";
}

<div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
    <div>
        <h2 class="mb-1">Staff Directory</h2>
        <p class="text-muted mb-0">Manage doctors, nurses, and administrative personnel.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-person-plus-fill me-1"></i> Add Staff Member
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="pro-card p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Name</th>
                    <th>Username</th>
                    <th>Role</th>
                    <th>Category / Dept</th>
                    <th>Registered On</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4 fw-bold">@item.FullName</td>
                        <td class="text-muted">@item.Username</td>
                        <td>
                            @if (item.Role.RoleName == "Doctor")
                            {
                                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle px-2 py-1">@item.Role.RoleName</span>
                            }
                            else if (item.Role.RoleName == "Admin")
                            {
                                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger-subtle px-2 py-1">@item.Role.RoleName</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary-subtle px-2 py-1">@item.Role.RoleName</span>
                            }
                        </td>
                        <td>@item.Category</td>
                        <td>@item.CreatedAt.ToString("MMM dd, yyyy")</td>
                        <td class="text-end pe-4">
                            <div class="btn-group">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
