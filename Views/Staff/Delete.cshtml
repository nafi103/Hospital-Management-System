@model HospitalManagementSystem.Models.User

@{
    ViewData["Title"] = "Delete Staff";
}

<div class="mb-4 border-bottom pb-3">
    <a asp-action="Index" class="text-decoration-none text-muted mb-2 d-inline-block">
        <i class="bi bi-arrow-left"></i> Back to Directory
    </a>
    <h2 class="mb-1 text-danger">Delete Staff Member</h2>
</div>

<div class="row">
    <div class="col-md-6 mx-auto">
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (ViewBag.CanDelete == false)
        {
            <div class="alert alert-danger mb-4">
                <i class="bi bi-shield-x me-2"></i> <strong>Operation Blocked:</strong> @ViewBag.DeleteWarning
            </div>
        }
        else
        {
            <div class="alert alert-warning">
                <h5 class="alert-heading"><i class="bi bi-exclamation-triangle"></i> Are you sure you want to delete this staff member?</h5>
                <p class="mb-0">This action cannot be undone. If this staff member is linked to existing hospital records, the deletion will be blocked to maintain data integrity.</p>
            </div>
        }

        <div class="pro-card mt-4">
            <h5 class="border-bottom pb-2 mb-3">Staff Details</h5>
            <dl class="row mb-0">
                <dt class="col-sm-4 text-muted">Full Name</dt>
                <dd class="col-sm-8 fw-bold">@Model.FullName</dd>

                <dt class="col-sm-4 text-muted">Username</dt>
                <dd class="col-sm-8">@Model.Username</dd>

                <dt class="col-sm-4 text-muted">Role</dt>
                <dd class="col-sm-8">
                    <span class="badge bg-secondary">@Model.Role?.RoleName</span>
                </dd>

                <dt class="col-sm-4 text-muted">Department</dt>
                <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Category) ? "N/A" : Model.Category)</dd>

                <dt class="col-sm-4 text-muted">Registered On</dt>
                <dd class="col-sm-8">@Model.CreatedAt.ToString("f")</dd>
            </dl>

            <form asp-action="Delete" class="mt-4 border-top pt-3 text-end">
                <input type="hidden" asp-for="Id" />
                <a asp-action="Index" class="btn btn-light border me-2">Cancel</a>
                @if (ViewBag.CanDelete == false)
                {
                    <button type="submit" class="btn btn-danger" disabled title="@ViewBag.DeleteWarning">
                        <i class="bi bi-shield-x"></i> Deletion Blocked
                    </button>
                }
                else
                {
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash"></i> Yes, Delete Staff Member
                    </button>
                }
            </form>
        </div>
    </div>
</div>
