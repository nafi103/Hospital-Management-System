@model HospitalManagementSystem.Models.Medicine

@{
    ViewData["Title"] = "Edit Medicine";
}

<div class="mb-4 border-bottom pb-3">
    <a asp-action="Index" class="text-decoration-none text-muted mb-2 d-inline-block">
        <i class="bi bi-arrow-left"></i> Back to Inventory
    </a>
    <h2 class="mb-1">Edit Medicine</h2>
    <p class="text-muted mb-0">Update details and stock levels for @Model.Name.</p>
</div>

<div class="row">
    <div class="col-md-6 mx-auto">
        <div class="pro-card">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <input type="hidden" asp-for="Id" />

                <input type="hidden" asp-for="CreatedAt" />
                
                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-medium">Medicine Name <span class="text-danger">*</span></label>
                    <input asp-for="Name" class="form-control" required />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                
                <div class="row mb-4">
                    <div class="col-md-6">
                        <label asp-for="UnitPrice" class="form-label fw-medium">Unit Price (৳) <span class="text-danger">*</span></label>
                        <input asp-for="UnitPrice" type="number" step="0.01" class="form-control" required />
                        <span asp-validation-for="UnitPrice" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="StockQuantity" class="form-label fw-medium">Stock Quantity <span class="text-danger">*</span></label>
                        <input asp-for="StockQuantity" type="number" class="form-control" required />
                        <span asp-validation-for="StockQuantity" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-light border">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4"><i class="bi bi-save me-1"></i> Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
