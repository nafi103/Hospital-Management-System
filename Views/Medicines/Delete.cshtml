@model HospitalManagementSystem.Models.Medicine

@{
    ViewData["Title"] = "Delete Medicine";
}

<div class="mb-4 border-bottom pb-3">
    <a asp-action="Index" class="text-decoration-none text-muted mb-2 d-inline-block">
        <i class="bi bi-arrow-left"></i> Back to Inventory
    </a>
    <h2 class="mb-1 text-danger">Delete Medicine</h2>
    <p class="text-muted mb-0">Are you sure you want to remove this medicine from inventory?</p>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="pro-card border-danger border-opacity-50 border">
            <h5 class="text-danger mb-4"><i class="bi bi-exclamation-triangle me-2"></i> Confirmation</h5>
            
            <dl class="row mb-0">
                <dt class="col-sm-4 text-muted">Name</dt>
                <dd class="col-sm-8 fw-bold">@Model.Name</dd>

                <dt class="col-sm-4 text-muted">Generic Name</dt>
                <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.GenericName) ? "—" : Model.GenericName)</dd>

                <dt class="col-sm-4 text-muted">Strength</dt>
                <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Strength) ? "—" : Model.Strength)</dd>

                <dt class="col-sm-4 text-muted">Therapeutic Class</dt>
                <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.TherapeuticClass) ? "—" : Model.TherapeuticClass)</dd>

                <dt class="col-sm-4 text-muted">Unit Price</dt>
                <dd class="col-sm-8">৳@Model.UnitPrice.ToString("0.00")</dd>

                <dt class="col-sm-4 text-muted">Current Stock</dt>
                <dd class="col-sm-8">@Model.StockQuantity units</dd>
            </dl>

            @if (ViewBag.IsReferenced == true)
            {
                <div class="alert alert-danger mt-4 mb-0">
                    <i class="bi bi-shield-slash me-1"></i> <strong>Operation Blocked:</strong> This medicine cannot be deleted because it is referenced in <strong>@ViewBag.PrescriptionCount</strong> historical patient prescription(s). Hard-deleting it would corrupt clinical records. Please adjust stock to 0 or rename with "[Discontinued]" instead.
                </div>
            }
            else
            {
                <div class="alert alert-warning mt-4 mb-0">
                    <i class="bi bi-info-circle me-1"></i> Note: This medicine is currently unreferenced by any patient prescriptions and can be safely deleted.
                </div>
            }

            <form asp-action="Delete" class="mt-4 pt-3 border-top d-flex gap-2">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger" @(ViewBag.IsReferenced == true ? "disabled" : "")>
                    <i class="bi bi-trash me-1"></i> Delete Permanently
                </button>
                <a asp-action="Index" class="btn btn-light border">Cancel</a>
            </form>
        </div>
    </div>
</div>
