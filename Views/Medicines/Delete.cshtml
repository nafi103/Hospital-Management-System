@model HospitalManagementSystem.Models.Medicine

@{
    ViewData["Title"] = "Delete Medicine";
}

<div class="mb-4 border-bottom pb-3">
    <a asp-action="Index" class="text-decoration-none text-muted mb-2 d-inline-block">
        <i class="bi bi-arrow-left"></i> Back to Inventory
    </a>
    <h2 class="mb-1 text-danger">Delete Medicine</h2>
    <p class="text-muted mb-0">Are you sure you want to remove this medicine from inventory?</p>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="pro-card border-danger border-opacity-50 border">
            <h5 class="text-danger mb-4"><i class="bi bi-exclamation-triangle me-2"></i> Confirmation</h5>
            
            <dl class="row mb-0">
                <dt class="col-sm-4 text-muted">Name</dt>
                <dd class="col-sm-8 fw-bold">@Model.Name</dd>

                <dt class="col-sm-4 text-muted">Unit Price</dt>
                <dd class="col-sm-8">৳@Model.UnitPrice.ToString("0.00")</dd>

                <dt class="col-sm-4 text-muted">Current Stock</dt>
                <dd class="col-sm-8">@Model.StockQuantity units</dd>
            </dl>

            <div class="alert alert-warning mt-4 mb-0">
                <i class="bi bi-info-circle me-1"></i> Note: Deleting this medicine may affect past prescriptions linked to it. Consider setting stock to 0 instead if you want to keep historical records intact.
            </div>

            <form asp-action="Delete" class="mt-4 pt-3 border-top d-flex gap-2">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i> Delete Permanently</button>
                <a asp-action="Index" class="btn btn-light border">Cancel</a>
            </form>
        </div>
    </div>
</div>
