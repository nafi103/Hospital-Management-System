@model IEnumerable<HospitalManagementSystem.Models.Medicine>

@{
    ViewData["Title"] = "Pharmacy Inventory";
}

<div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
    <div>
        <h2 class="mb-1">Pharmacy Inventory</h2>
        <p class="text-muted mb-0">Manage medicine catalog and track stock levels.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i> Add Medicine
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="pro-card p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Medicine Name</th>
                    <th>Unit Price (৳)</th>
                    <th>Current Stock</th>
                    <th>Status</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">@item.Name</td>
                            <td>৳@item.UnitPrice.ToString("0.00")</td>
                            <td>
                                <span class="fw-medium">@item.StockQuantity</span> units
                            </td>
                            <td>
                                @if (item.StockQuantity <= 0)
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger-subtle">Out of Stock</span>
                                }
                                else if (item.StockQuantity < 50)
                                {
                                    <span class="badge bg-warning bg-opacity-10 text-warning border border-warning-subtle">Low Stock</span>
                                }
                                else
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle">In Stock</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="bi bi-box-seam fs-1 d-block mb-3 text-black-50"></i>
                            No medicines found in inventory.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
