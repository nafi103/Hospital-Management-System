@model IEnumerable<HospitalManagementSystem.Controllers.JsonMedicalRecord>

@{
    ViewData["Title"] = "Medical Records";
}

<div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
    <div>
        <h2 class="mb-1">Medical Records</h2>
        <p class="text-muted mb-0">Browse and manage patient clinical records (JSON Storage).</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-file-earmark-plus"></i> New Record
    </a>
</div>

<div class="pro-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Date</th>
                    <th>Patient</th>
                    <th>Doctor</th>
                    <th>Diagnosis Summary</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model) {
                <tr>
                    <td>
                        <div class="fw-medium">@item.Date.ToLocalTime().ToString("MMM dd, yyyy")</div>
                        <small class="text-muted">@item.Date.ToLocalTime().ToString("hh:mm tt")</small>
                    </td>
                    <td>
                        <div class="fw-bold text-primary">@item.PatientName</div>
                        <small class="text-muted">@item.PatientUhid</small>
                    </td>
                    <td>
                        <div class="fw-medium">@item.DoctorName</div>
                    </td>
                    <td>
                        <span class="text-truncate d-inline-block" style="max-width: 250px;" title="@item.Diagnosis">
                            @(string.IsNullOrEmpty(item.Diagnosis) ? "-" : item.Diagnosis)
                        </span>
                    </td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-light text-primary me-1" title="View Details">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-light text-danger" title="Delete">
                            <i class="bi bi-trash"></i>
                        </a>
                    </td>
                </tr>
                }
                
                @if(!Model.Any()) {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">
                            <i class="bi bi-clipboard-x fs-1 d-block mb-2 text-black-50"></i>
                            No medical records found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
