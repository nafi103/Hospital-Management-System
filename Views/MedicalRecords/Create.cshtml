@model HospitalManagementSystem.Controllers.JsonMedicalRecord

@{
    ViewData["Title"] = "Add Medical Record";
}

<div class="mb-4 border-bottom pb-3">
    <a asp-action="Index" class="text-decoration-none text-muted mb-2 d-inline-block">
        <i class="bi bi-arrow-left"></i> Back to Medical Records
    </a>
    <h2 class="mb-1">New Medical Record</h2>
    <p class="text-muted mb-0">Record clinical findings, diagnosis, and treatment plan.</p>
</div>

<div class="row">
    <div class="col-md-8 mx-auto">
        <div class="pro-card">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                
                <h5 class="card-title text-primary mb-4 border-bottom pb-2">Clinical Information</h5>
                
                <div class="row g-4 mb-4">
                    <div class="col-md-12">
                        <label class="form-label fw-medium">@(ViewBag.PreselectedPatientId != null ? "Patient" : "Find Patient") <span class="text-danger">*</span></label>
                        
                        <div class="position-relative mb-2" id="SearchWrapper" @(ViewBag.PreselectedPatientId != null ? "style=\"display:none;\"" : "")>
                            <div class="input-group" id="SearchGroup">
                                <span class="input-group-text bg-white text-muted"><i class="bi bi-search"></i></span>
                                <input type="text" id="PatientSearchInput" class="form-control" placeholder="Type UHID, Phone, or Name to search..." autocomplete="off">
                            </div>
                            <div id="SearchResults" class="list-group position-absolute w-100 shadow-sm" style="display: none; z-index: 1000; max-height: 250px; overflow-y: auto; top: 100%; left: 0; margin-top: 4px;"></div>
                        </div>

                        <div id="SelectedPatientCard" class="card border-primary bg-primary bg-opacity-10 mb-2" style="display: none;">
                            <div class="card-body d-flex justify-content-between align-items-center py-2">
                                <div>
                                    <h6 class="mb-0 fw-bold text-primary" id="SP_Name"></h6>
                                    <small class="text-muted" id="SP_Uhid"></small>
                                </div>
                                @if (ViewBag.PreselectedPatientId == null)
                                {
                                    <button type="button" class="btn btn-sm btn-light text-danger rounded-circle" id="ClearPatientBtn" title="Clear selection">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                }
                            </div>
                        </div>

                        <input type="hidden" asp-for="PatientId" id="PatientIdHidden" required />
                        <span asp-validation-for="PatientId" class="text-danger small"></span>
                    </div>

                    @if (ViewBag.PreselectedDoctorId != null)
                    {
                        <input type="hidden" asp-for="DoctorId" value="@ViewBag.PreselectedDoctorId" />
                    }
                    else
                    {
                        <div class="col-md-12">
                            <label asp-for="DoctorId" class="form-label fw-medium">Attending Doctor <span class="text-danger">*</span></label>
                            <select asp-for="DoctorId" class="form-select" asp-items="ViewBag.DoctorId" required>
                                <option value="">-- Assign Doctor --</option>
                            </select>
                            <span asp-validation-for="DoctorId" class="text-danger small"></span>
                        </div>
                    }

                    <div class="col-md-12">
                        <label asp-for="Diagnosis" class="form-label fw-medium">Diagnosis <span class="text-danger">*</span></label>
                        <textarea asp-for="Diagnosis" class="form-control" rows="4" placeholder="Enter detailed clinical diagnosis..." required></textarea>
                        <span asp-validation-for="Diagnosis" class="text-danger small"></span>
                    </div>
                    
                    <div class="col-md-12">
                        <label asp-for="Treatment" class="form-label fw-medium">Treatment Plan <span class="text-danger">*</span></label>
                        <textarea asp-for="Treatment" class="form-control" rows="5" placeholder="Prescribed medications, procedures, lifestyle advice..." required></textarea>
                        <span asp-validation-for="Treatment" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Index" class="btn btn-light border">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4"><i class="bi bi-save me-1"></i> Save Record</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function() {
            var searchTimeout;
            
            $('#PatientSearchInput').on('input', function() {
                clearTimeout(searchTimeout);
                var query = $(this).val().trim();
                
                if(query.length < 1) {
                    $('#SearchResults').hide();
                    return;
                }

                searchTimeout = setTimeout(function() {
                    performSearch(query);
                }, 300);
            });

            var currentFocus = -1;

            $('#PatientSearchInput').keydown(function(e) {
                var list = $('#SearchResults .list-group-item:not(.text-center)');
                if (e.which == 40) {
                    e.preventDefault();
                    currentFocus++;
                    addActive(list);
                } else if (e.which == 38) {
                    e.preventDefault();
                    currentFocus--;
                    addActive(list);
                } else if (e.which == 13) {
                    e.preventDefault();
                    if (currentFocus > -1) {
                        if (list) list[currentFocus].click();
                    } else {
                        var query = $(this).val().trim();
                        if(query.length >= 1) performSearch(query);
                    }
                }
            });

            function addActive(x) {
                if (!x || x.length === 0) return false;
                removeActive(x);
                if (currentFocus >= x.length) currentFocus = 0;
                if (currentFocus < 0) currentFocus = (x.length - 1);
                $(x[currentFocus]).addClass('search-item-active').removeClass('text-muted');
                x[currentFocus].scrollIntoView({ block: 'nearest' });
            }

            function removeActive(x) {
                for (var i = 0; i < x.length; i++) {
                    $(x[i]).removeClass('search-item-active');
                }
            }

            function performSearch(query) {
                $.ajax({
                    url: '@Url.Action("Search", "Patients")',
                    data: { q: query },
                    success: function(data) {
                        $('#SearchResults').empty().show();
                        currentFocus = -1;
                        if(data.results.length === 0) {
                            $('#SearchResults').append('<div class="list-group-item text-muted text-center py-3">No patients found matching "'+query+'"</div>');
                        } else {
                            data.results.forEach(function(p) {
                                var parts = p.text.split(" - ");
                                var uhid = parts[0];
                                var name = parts[1];

                                var item = $('<a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"></a>')
                                    .html('<div><span class="fw-bold">' + name + '</span><br><small class="text-muted">' + uhid + '</small></div> <i class="bi bi-chevron-right text-muted"></i>')
                                    .click(function(e) {
                                        e.preventDefault();
                                        selectPatient(p.id, uhid, name);
                                    });
                                $('#SearchResults').append(item);
                            });
                        }
                    }
                });
            }

            $(document).click(function(e) {
                if (!$(e.target).closest('#SearchWrapper').length) {
                    $('#SearchResults').hide();
                }
            });

            function selectPatient(id, uhid, name) {
                $('#PatientIdHidden').val(id);
                $('#SP_Uhid').text(uhid);
                $('#SP_Name').text(name);
                
                $('#SearchResults').hide();
                $('#SearchWrapper').hide();
                $('#SelectedPatientCard').fadeIn();
            }

            $('#ClearPatientBtn').click(function() {
                $('#PatientIdHidden').val('');
                $('#SelectedPatientCard').hide();
                $('#SearchWrapper').fadeIn();
                $('#PatientSearchInput').val('').focus();
            });

            @if (ViewBag.PreselectedPatientId != null)
            {
                @:selectPatient('@ViewBag.PreselectedPatientId', '@ViewBag.PreselectedPatientUhid', '@Html.Raw(ViewBag.PreselectedPatientName)');
            }
        });
    </script>
}
