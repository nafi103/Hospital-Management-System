@model HospitalManagementSystem.Controllers.JsonMedicalRecord

@{
    ViewData["Title"] = "Delete Record";
}

<div class="mb-4 border-bottom pb-3">
    <a asp-action="Index" class="text-decoration-none text-muted mb-2 d-inline-block">
        <i class="bi bi-arrow-left"></i> Back to Medical Records
    </a>
    <h2 class="mb-1 text-danger">Delete Record</h2>
    <p class="text-muted mb-0">Are you sure you want to completely remove this medical record?</p>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="pro-card border-danger border-opacity-50 border">
            <h5 class="text-danger mb-4"><i class="bi bi-exclamation-triangle me-2"></i> Confirmation</h5>
            
            <dl class="row mb-0">
                <dt class="col-sm-4 text-muted">Patient</dt>
                <dd class="col-sm-8 fw-bold">@Model.PatientName (@Model.PatientUhid)</dd>

                <dt class="col-sm-4 text-muted">Doctor</dt>
                <dd class="col-sm-8">@Model.DoctorName</dd>

                <dt class="col-sm-4 text-muted">Date</dt>
                <dd class="col-sm-8">@Model.Date.ToLocalTime().ToString("MMM dd, yyyy")</dd>
            </dl>

            <form asp-action="Delete" class="mt-4 pt-3 border-top d-flex gap-2">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i> Delete Record</button>
                <a asp-action="Index" class="btn btn-light border">Keep It</a>
            </form>
        </div>
    </div>
</div>
