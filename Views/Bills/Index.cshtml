@model IEnumerable<HospitalManagementSystem.Models.Bill>

@{
    ViewData["Title"] = "Billing & Invoicing";
}

<div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
    <div>
        <h2 class="mb-1">Billing & Invoicing</h2>
        <p class="text-muted mb-0">Manage patient bills and record payments.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-receipt me-1"></i> Generate New Bill
    </a>
</div>

<div class="pro-card p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Date</th>
                    <th>Patient</th>
                    <th>Net Total</th>
                    <th>Paid</th>
                    <th>Status</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="fw-medium">@item.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")</div>
                            </td>
                            <td>
                                <div class="fw-bold text-primary">@item.Patient.FullName</div>
                                <small class="text-muted">@item.Patient.Uhid</small>
                            </td>
                            <td class="fw-bold">৳@item.NetTotal.ToString("0.00")</td>
                            <td class="text-success fw-medium">৳@item.PaidAmount.ToString("0.00")</td>
                            <td>
                                @if (item.Status == HospitalManagementSystem.Models.BillStatus.Paid)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle px-2 py-1">Fully Paid</span>
                                }
                                else if (item.Status == HospitalManagementSystem.Models.BillStatus.PartiallyPaid)
                                {
                                    <span class="badge bg-warning bg-opacity-10 text-warning border border-warning-subtle px-2 py-1">Partial</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger-subtle px-2 py-1">Unpaid</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="View Invoice">
                                        <i class="bi bi-file-earmark-text"></i> Invoice
                                    </a>
                                    @if (item.Status != HospitalManagementSystem.Models.BillStatus.Paid)
                                    {
                                        <a asp-action="Payment" asp-route-id="@item.Id" class="btn btn-sm btn-outline-success" title="Record Payment">
                                            <i class="bi bi-cash-coin"></i> Pay
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-receipt fs-2 d-block mb-3"></i>
                            No bills found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
