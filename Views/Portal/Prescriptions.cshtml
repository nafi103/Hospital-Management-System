@model IEnumerable<HospitalManagementSystem.Models.Prescription>
@using HospitalManagementSystem.Models
@{
    ViewData["Title"] = "My Prescriptions";
    var patient = (Patient)ViewBag.Patient;
}

<div class="mb-4 border-bottom pb-3">
    <h2 class="mb-1">My Prescriptions</h2>
    <p class="text-muted mb-0">Prescriptions issued to UHID: <span class="fw-medium">@patient.Uhid</span></p>
</div>

@if (Model != null && Model.Any())
{
    <div class="row g-4">
        @foreach (var prescription in Model)
        {
            <div class="col-12">
                <div class="pro-card">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h5 class="mb-1">@(string.IsNullOrEmpty(prescription.Diagnosis) ? "Prescription #" + prescription.Id : prescription.Diagnosis)</h5>
                            <small class="text-muted">@prescription.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy") &middot; Dr. @prescription.Doctor?.FullName</small>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            @if (prescription.Status == PrescriptionStatus.PendingPharmacy)
                            {
                                <span class="badge bg-warning bg-opacity-10 text-warning border border-warning-subtle">
                                    <i class="bi bi-hourglass-split me-1"></i> Pending Dispense
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle">
                                    <i class="bi bi-check2-all me-1"></i> Dispensed
                                </span>
                            }
                            <a asp-action="Print" asp-controller="Prescriptions" asp-route-id="@prescription.Id" target="_blank" class="btn btn-sm btn-outline-secondary" title="Print">
                                <i class="bi bi-printer"></i>
                            </a>
                        </div>
                    </div>
                    <ul class="list-group list-group-flush">
                        @foreach (var item in prescription.PrescriptionItems)
                        {
                            <li class="list-group-item px-0 d-flex justify-content-between">
                                <span>@item.Medicine?.Name <small class="text-muted">(@item.DoseDisplay)</small></span>
                                <span class="text-muted">Qty @item.Quantity</span>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="pro-card text-center py-5">
        <i class="bi bi-capsule fs-2 d-block mb-3 text-muted"></i>
        <p class="text-muted mb-0">No prescriptions yet.</p>
    </div>
}
