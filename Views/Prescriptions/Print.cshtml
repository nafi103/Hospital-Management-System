@model HospitalManagementSystem.Models.Prescription

@{
    Layout = null; // No layout, pure print view
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Prescription - @Model.Patient.FullName - AGY Hospital</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
        
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8f9fa;
            color: #212529;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        .a4-page {
            width: 21cm;
            min-height: 29.7cm;
            padding: 2cm;
            margin: 1cm auto;
            border: 1px solid #dee2e6;
            border-radius: 5px;
            background: white;
            box-shadow: 0 0 5px rgba(0, 0, 0, 0.1);
            position: relative;
        }

        .header-brand {
            font-size: 24px;
            font-weight: 700;
            color: #0d6efd;
            letter-spacing: -0.5px;
        }

        .rx-symbol {
            font-size: 4rem;
            font-weight: bold;
            color: #dee2e6;
            font-style: italic;
            line-height: 1;
            margin-bottom: -1rem;
        }

        .prescription-list {
            margin-top: 1.5rem;
        }

        .medicine-item {
            margin-bottom: 1.5rem;
            page-break-inside: avoid;
        }

        .medicine-name {
            font-size: 1.1rem;
            font-weight: 600;
            color: #000;
        }

        .medicine-generic {
            font-size: 0.9rem;
            color: #6c757d;
        }

        .medicine-details {
            font-size: 0.95rem;
            color: #495057;
            margin-top: 0.25rem;
        }
        
        .medicine-instructions {
            font-size: 0.85rem;
            color: #6c757d;
            font-style: italic;
        }

        .footer-signature {
            position: absolute;
            bottom: 2cm;
            right: 2cm;
            text-align: center;
            width: 200px;
        }

        .signature-line {
            border-top: 1px solid #000;
            margin-bottom: 0.5rem;
            padding-top: 0.5rem;
            font-weight: 600;
        }

        .print-btn-container {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 1000;
        }

        @@media print {
            body {
                background: white;
                margin: 0;
                padding: 0;
            }
            .a4-page {
                margin: 0;
                border: none;
                border-radius: 0;
                box-shadow: none;
                width: 100%;
                height: 100%;
                page-break-after: always;
                padding: 1cm;
            }
            .print-btn-container {
                display: none !important;
            }
            .footer-signature {
                bottom: 1cm;
                right: 1cm;
            }
        }
    </style>
</head>
<body>

    <div class="print-btn-container d-print-none">
        <button onclick="window.print()" class="btn btn-primary btn-lg shadow rounded-pill px-4">
            <i class="bi bi-printer me-2"></i> Print
        </button>
        <button onclick="window.close()" class="btn btn-light btn-lg shadow rounded-pill px-4 ms-2 border">
            Close
        </button>
    </div>

    <div class="a4-page">
        <!-- Header -->
        <header class="d-flex justify-content-between align-items-end border-bottom pb-4 mb-4">
            <div>
                <div class="header-brand mb-2">
                    <i class="bi bi-hospital text-primary me-2"></i>AGY Hospital
                </div>
                <div class="text-muted small">
                    123 Health Avenue, Medical District<br />
                    Cityville, ST 12345<br />
                    Phone: (555) 123-4567 | Web: www.agyhospital.com
                </div>
            </div>
            <div class="text-end">
                <h5 class="fw-bold mb-1">Dr. @Model.Doctor.FullName</h5>
                <div class="text-muted small mb-1">@Model.Doctor.Category Specialist</div>
                <div class="text-muted small">Reg No: DOC-@Model.DoctorId.ToString("D4")</div>
            </div>
        </header>

        <!-- Patient Info -->
        <div class="row mb-4 bg-light p-3 rounded mx-0">
            <div class="col-md-6 px-0">
                <div class="fw-bold fs-5 mb-1">@Model.Patient.FullName</div>
                <div class="text-muted small">
                    UHID: @Model.Patient.Uhid<br />
                    Gender: @Model.Patient.Gender | Blood Group: @(string.IsNullOrEmpty(Model.Patient.BloodGroup) ? "N/A" : Model.Patient.BloodGroup)<br />
                    Phone: @Model.Patient.ContactInfo
                </div>
            </div>
            <div class="col-md-6 text-end px-0">
                <div class="mb-1"><strong>Date:</strong> @Model.CreatedAt.ToString("MMM dd, yyyy")</div>
                <div class="text-muted small"><strong>Prescription ID:</strong> RX-@Model.Id.ToString("D6")</div>
            </div>
        </div>

        <!-- Clinical Notes -->
        <div class="row mb-4">
            <div class="col-6">
                <h6 class="text-primary fw-bold border-bottom pb-1 mb-2">Chief Complaints</h6>
                <p class="small text-dark mb-0">@(string.IsNullOrWhiteSpace(Model.ChiefComplaints) ? "None recorded." : Model.ChiefComplaints)</p>
            </div>
            <div class="col-6">
                <h6 class="text-primary fw-bold border-bottom pb-1 mb-2">Diagnosis</h6>
                <p class="small text-dark mb-0">@(string.IsNullOrWhiteSpace(Model.Diagnosis) ? "Pending diagnosis." : Model.Diagnosis)</p>
            </div>
        </div>

        <!-- Medicines -->
        <div class="rx-symbol">Rx</div>
        <div class="prescription-list ms-4">
            @if (Model.PrescriptionItems != null && Model.PrescriptionItems.Any())
            {
                int index = 1;
                foreach (var item in Model.PrescriptionItems)
                {
                    <div class="medicine-item">
                        <div class="d-flex align-items-baseline">
                            <span class="me-2 fw-bold text-muted">@index.</span>
                            <span class="medicine-name">@item.Medicine.Name</span>
                            <span class="medicine-generic ms-2">(@item.Medicine.GenericName)</span>
                        </div>
                        <div class="medicine-details ms-4">
                            <strong>Dose:</strong> @item.Dosage &nbsp;|&nbsp; <strong>Duration:</strong> @item.Duration &nbsp;|&nbsp; <strong>Qty:</strong> @item.Quantity
                        </div>
                        @if (!string.IsNullOrWhiteSpace(item.Instructions))
                        {
                            <div class="medicine-instructions ms-4 mt-1">
                                <i class="bi bi-info-circle me-1"></i> @item.Instructions
                            </div>
                        }
                    </div>
                    index++;
                }
            }
            else
            {
                <div class="text-muted fst-italic">No medicines prescribed.</div>
            }
        </div>

        <!-- General Notes -->
        @if (!string.IsNullOrWhiteSpace(Model.Notes))
        {
            <div class="mt-5 border-top pt-3">
                <h6 class="text-primary fw-bold mb-2">General Advice / Instructions</h6>
                <p class="small">@Model.Notes</p>
            </div>
        }

        <!-- Footer Signature -->
        <div class="footer-signature">
            <div class="signature-line">
                Dr. @Model.Doctor.FullName
            </div>
            <div class="small text-muted">Signature & Seal</div>
        </div>
    </div>

</body>
</html>
