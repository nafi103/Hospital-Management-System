@model IEnumerable<HospitalManagementSystem.Models.Prescription>

@{
    ViewData["Title"] = "Prescriptions";
}

<div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
    <div>
        <h2 class="mb-1">Prescriptions</h2>
        <p class="text-muted mb-0">Manage patient prescriptions and pharmacy dispensing.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-file-medical-fill me-1"></i> New Prescription
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="pro-card p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Date</th>
                    <th>Patient</th>
                    <th>Prescribed By</th>
                    <th>Status</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="fw-medium">@item.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")</div>
                                <small class="text-muted">@item.CreatedAt.ToLocalTime().ToString("hh:mm tt")</small>
                            </td>
                            <td>
                                <div class="fw-bold">@item.Patient.FullName</div>
                                <small class="text-muted">@item.Patient.Uhid</small>
                            </td>
                            <td>
                                <i class="bi bi-heart-pulse text-primary me-1"></i> @item.Doctor.FullName
                            </td>
                            <td>
                                @if (item.Status == HospitalManagementSystem.Models.PrescriptionStatus.PendingPharmacy)
                                {
                                    <span class="badge bg-warning bg-opacity-10 text-warning border border-warning-subtle">
                                        <i class="bi bi-hourglass-split me-1"></i> Pending Dispense
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle">
                                        <i class="bi bi-check2-all me-1"></i> Dispensed
                                    </span>
                                }
                            </td>
                            <td>
                                <div class="d-flex gap-2 justify-content-end pe-4">
                                    <a asp-action="Print" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary" target="_blank" title="Print Prescription">
                                        <i class="bi bi-printer"></i>
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="View Details">
                                        <i class="bi bi-eye"></i> View
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-3 text-black-50"></i>
                            No prescriptions found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
