@{
    ViewData["Title"] = "Log In";
    Layout = "_Layout";
}

<div class="row justify-content-center align-items-center" style="min-height: 70vh;">
    <div class="col-md-10 col-lg-8">
        <div class="card border-0 shadow-lg" style="border-radius: 1rem;">
            <div class="card-body p-5 text-center">
                <i class="bi bi-hospital text-primary mb-3 d-block" style="font-size: 3rem;"></i>
                <h3 class="fw-bold mb-1">Welcome Back</h3>
                <div class="row g-4 mt-2">
                    <div class="col-md-5">
                        <h5 class="mb-4 text-secondary border-bottom pb-2">Real Login</h5>
                        @if (ViewBag.Error != null)
                        {
                            <div class="alert alert-danger py-2">@ViewBag.Error</div>
                        }
                        <form asp-action="Login" method="post">
                            <div class="mb-3">
                                <label class="form-label">Username</label>
                                <input type="text" name="username" class="form-control" required />
                            </div>
                            <div class="mb-4">
                                <label class="form-label">Password</label>
                                <input type="password" name="password" class="form-control" required />
                            </div>
                            <button type="submit" class="btn btn-primary w-100 mb-2">Log In</button>
                            <div class="mt-3 p-2 bg-light rounded border text-muted small text-start">
                                <div class="fw-bold mb-1 text-secondary">Demo Credentials:</div>
                                <div>&bull; <strong>Admin:</strong> <code>admin</code> / <code>admin123</code></div>
                                <div>&bull; <strong>Doctor:</strong> <code>drmock</code> / <code>password123</code></div>
                                <div>&bull; <strong>Staff:</strong> <code>dr2</code>, <code>assistant2</code>, <code>reception1</code> / <code>Passw0rd!</code></div>
                                <div>&bull; <strong>Patient:</strong> <code>PT-202609-0001</code> / <code>Patient@123</code></div>
                            </div>
                        </form>
                    </div>

                    <div class="col-md-7 border-start">
                        <h5 class="mb-4 text-secondary border-bottom pb-2">One-Click Mock Login (Testing)</h5>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <form asp-action="MockLogin" method="post">
                                    <input type="hidden" name="role" value="Assistant" />
                                    <button type="submit" class="btn btn-outline-primary w-100 py-3 h-100 rounded-3 text-start">
                                        <div class="d-flex flex-column align-items-center text-center">
                                            <i class="bi bi-person-badge fs-2 mb-2"></i>
                                            <h6 class="mb-1 fw-bold">Mock Assistant</h6>
                                            <small class="text-muted d-block mt-1" style="font-size: 0.75rem;">Registration & Queue</small>
                                        </div>
                                    </button>
                                </form>
                            </div>
                            
                            <div class="col-md-6">
                                <form asp-action="MockLogin" method="post">
                                    <input type="hidden" name="role" value="Doctor" />
                                    <button type="submit" class="btn btn-outline-success w-100 py-3 h-100 rounded-3 text-start">
                                        <div class="d-flex flex-column align-items-center text-center">
                                            <i class="bi bi-heart-pulse fs-2 mb-2"></i>
                                            <h6 class="mb-1 fw-bold">Mock Doctor</h6>
                                            <small class="text-muted d-block mt-1" style="font-size: 0.75rem;">Consultations & Rx</small>
                                        </div>
                                    </button>
                                </form>
                            </div>

                            <div class="col-md-6 mt-2">
                                <form asp-action="MockLogin" method="post">
                                    <input type="hidden" name="role" value="Pharmacist" />
                                    <button type="submit" class="btn btn-outline-info w-100 py-3 h-100 rounded-3 text-start">
                                        <div class="d-flex flex-column align-items-center text-center">
                                            <i class="bi bi-capsule fs-2 mb-2"></i>
                                            <h6 class="mb-1 fw-bold">Mock Pharmacist</h6>
                                            <small class="text-muted d-block mt-1" style="font-size: 0.75rem;">Dispense Meds</small>
                                        </div>
                                    </button>
                                </form>
                            </div>

                            <div class="col-md-6 mt-2">
                                <form asp-action="MockLogin" method="post">
                                    <input type="hidden" name="role" value="Admin" />
                                    <button type="submit" class="btn btn-outline-dark w-100 py-3 h-100 rounded-3 text-start">
                                        <div class="d-flex flex-column align-items-center text-center">
                                            <i class="bi bi-shield-lock fs-2 mb-2"></i>
                                            <h6 class="mb-1 fw-bold">Mock System Admin</h6>
                                            <small class="text-muted d-block mt-1" style="font-size: 0.75rem;">Full Access</small>
                                        </div>
                                    </button>
                                </form>
                            </div>

                            <div class="col-md-6 mt-2">
                                <form asp-action="MockLogin" method="post">
                                    <input type="hidden" name="role" value="Receptionist" />
                                    <button type="submit" class="btn btn-outline-warning w-100 py-3 h-100 rounded-3 text-start">
                                        <div class="d-flex flex-column align-items-center text-center">
                                            <i class="bi bi-person-vcard fs-2 mb-2"></i>
                                            <h6 class="mb-1 fw-bold">Mock Receptionist</h6>
                                            <small class="text-muted d-block mt-1" style="font-size: 0.75rem;">Front Desk</small>
                                        </div>
                                    </button>
                                </form>
                            </div>

                            <div class="col-md-6 mt-2">
                                <form asp-action="MockLogin" method="post">
                                    <input type="hidden" name="role" value="Patient" />
                                    <button type="submit" class="btn btn-outline-secondary w-100 py-3 h-100 rounded-3 text-start">
                                        <div class="d-flex flex-column align-items-center text-center">
                                            <i class="bi bi-person-heart fs-2 mb-2 text-primary"></i>
                                            <h6 class="mb-1 fw-bold">Mock Patient</h6>
                                            <small class="text-muted d-block mt-1" style="font-size: 0.75rem;">Patient Portal</small>
                                        </div>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="mt-4 pt-4 border-top text-muted small">
                    For demonstration purposes, passwords are not required.
                </div>
            </div>
        </div>
    </div>
</div>
