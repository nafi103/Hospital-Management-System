@{
    ViewData["Title"] = "Dashboard";
}

<div class="mb-5 border-bottom pb-4">
    <h2 class="mb-1">Hospital Dashboard</h2>
    <p class="text-muted mb-0">Overview of facility operations and quick access modules.</p>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="pro-card h-100">
            <div class="icon-box">
                <i class="bi bi-people-fill"></i>
            </div>
            <h4 class="mb-2">Patient Directory</h4>
            <p class="text-muted mb-4 small">Manage patient registrations, search medical records, and oversee hospital admissions.</p>
            <a asp-controller="Patients" asp-action="Index" class="btn btn-primary w-100">Manage Patients</a>
        </div>
    </div>
    
    <div class="col-md-4">
        <div class="pro-card h-100">
            <div class="icon-box" style="background-color: rgba(25, 135, 84, 0.1); color: #198754;">
                <i class="bi bi-file-medical-fill"></i>
            </div>
            <h4 class="mb-2">Bed Availability</h4>
            <p class="text-muted mb-4 small">Monitor real-time occupancy status for ICUs, General Wards, and private Cabins.</p>
            <button class="btn btn-outline-secondary w-100" disabled>View Beds (Pending)</button>
        </div>
    </div>

    <div class="col-md-4">
        <div class="pro-card h-100">
            <div class="icon-box" style="background-color: rgba(253, 126, 20, 0.1); color: #fd7e14;">
                <i class="bi bi-calendar2-check-fill"></i>
            </div>
            <h4 class="mb-2">Appointments</h4>
            <p class="text-muted mb-4 small">Schedule Outpatient Department (OPD) visits and track surgical operation schedules.</p>
            <button class="btn btn-outline-secondary w-100" disabled>Schedule (Pending)</button>
        </div>
    </div>
</div>
