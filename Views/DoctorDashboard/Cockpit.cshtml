@model HospitalManagementSystem.Models.ViewModels.ClinicalCockpitViewModel
@using HospitalManagementSystem.Models
@using HospitalManagementSystem.Services

@{
    ViewData["Title"] = $"Clinical Cockpit - {Model.Patient.FullName}";
    ViewBag.FluidLayout = true;
    var dashboardUrl = Url.Action("Index", "DoctorDashboard");
    var hasAllergies = Model.Allergies != null && Model.Allergies.Any();
    var hasVitals = Model.LatestVitals != null;
    var isChild = Model.Patient.IsChild;
    var news2 = Model.News2Result;
    var pastRecords = ViewBag.PastMedicalRecords as List<MedicalRecord> ?? new List<MedicalRecord>();
}

@section Styles {
    <style>
        .vitals-tile {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 6px;
            padding: 0.25rem 0.5rem;
            text-align: center;
        }
        .allergy-badge-danger {
            background-color: #fee2e2;
            color: #991b1b;
            border: 1px solid #f87171;
            font-weight: 600;
        }
        .hover-border-primary:hover {
            border-color: var(--accent) !important;
        }
        .transition-all {
            transition: all 0.2s ease-in-out;
        }
    </style>
}

<div class="cockpit-shell cockpit-shell-locked">
    <!-- SUB-NAV & SAFETY BANNER -->
    <div class="d-flex justify-content-between align-items-center px-3 py-2 bg-surface-card border-bottom">
        <div class="d-flex align-items-center gap-2">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary px-2 py-1" title="Back to Doctor's Desk">
                <i class="bi bi-arrow-left"></i>
            </a>
            <div class="line-height-1">
                <div class="d-flex align-items-center gap-2">
                    <span class="fw-bold text-strong fs-6">@Model.Patient.FullName</span>
                    <span class="uhid-badge">@Model.Patient.Uhid</span>
                    @if (isChild)
                    {
                        <span class="badge bg-warning text-dark"><i class="bi bi-balloon me-1"></i>Pediatric</span>
                    }
                </div>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <form asp-action="ReturnToWaitingRoom" asp-route-id="@Model.Appointment.Id" method="post" class="d-inline" onsubmit="return confirm('Return this patient to the waiting room queue?');">
                <button type="submit" class="btn btn-outline-warning btn-sm py-1">
                    <i class="bi bi-arrow-return-left me-1"></i> Return to Queue
                </button>
            </form>
            <button type="button" class="btn btn-outline-danger btn-sm py-1" onclick="cancelWalkout(@Model.Appointment.Id)">
                <i class="bi bi-x-circle me-1"></i> Walkout / Cancel
            </button>
        </div>
    </div>

    <!-- OMNIPRESENT PATIENT SAFETY STRIP -->
    <div class="cockpit-top-strip">
        <div class="row align-items-center g-3">
            <!-- Patient Demographics -->
            <div class="col-lg-3 col-md-6 border-end-lg border-subtle">
                <div class="small strip-label">
                    <span>Age: <strong class="strip-val">@Model.AgeDisplay</strong></span> &bull;
                    <span>Gender: <strong class="strip-val">@Model.Patient.Gender</strong></span> &bull;
                    <span>Blood: <strong class="text-danger fw-bold">@Model.Patient.BloodGroup</strong></span>
                </div>
                @if (isChild && Model.Patient.GuardianPatient != null)
                {
                    <div class="small text-info mt-1" style="font-size: 0.75rem;">
                        <i class="bi bi-shield-lock me-1"></i>Guardian: @Model.Patient.GuardianPatient.FullName (@(Model.Patient.GuardianRelationship ?? "Parent"))
                    </div>
                }
                @if (Model.ActiveMedications.Any())
                {
                    <div class="mt-1">
                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle" style="font-size: 0.7rem;">
                            <i class="bi bi-capsule me-1"></i>@Model.ActiveMedications.Count Active Regimens
                        </span>
                    </div>
                }
            </div>

            <!-- Allergies Banner -->
            <div class="col-lg-4 col-md-6 border-end-lg border-subtle">
                <div class="small text-uppercase tracking-wider strip-label mb-1 fw-bold" style="font-size: 0.7rem;">
                    <i class="bi bi-shield-exclamation me-1"></i>Known Allergies
                </div>
                @if (hasAllergies)
                {
                    <div class="d-flex flex-wrap gap-1">
                        @foreach (var allergy in Model.Allergies)
                        {
                            var isSevere = allergy.Severity == AllergySeverity.LifeThreatening || allergy.Severity == AllergySeverity.Severe;
                            <span class="badge @(isSevere ? "allergy-badge-danger" : "bg-warning bg-opacity-25 text-warning border border-warning") py-1 px-2" title="@allergy.ReactionType">
                                <i class="bi @(isSevere ? "bi-exclamation-octagon-fill" : "bi-exclamation-triangle") me-1"></i>
                                @allergy.Substance (@allergy.Severity)
                            </span>
                        }
                    </div>
                }
                else
                {
                    <span class="badge bg-success-subtle text-success border border-success-subtle py-1 px-2" style="font-size: 0.75rem;">
                        <i class="bi bi-check-circle me-1"></i>No Known Drug Allergies (NKDA)
                    </span>
                }
            </div>

            <!-- Vitals Telemetry Grid -->
            <div class="col-lg-5 col-12">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="small text-uppercase tracking-wider strip-label fw-bold" style="font-size: 0.7rem;">
                        <i class="bi bi-activity me-1"></i>Vitals &amp; &Delta;NEWS2
                    </span>
                    @if (news2.HasValue)
                    {
                        var nColor = news2.Value.Priority == TriagePriority.Emergency ? "bg-danger" : (news2.Value.Priority == TriagePriority.Urgent ? "bg-warning text-dark" : "bg-success");
                        <span class="badge @nColor font-mono-data" style="font-size: 0.75rem;">
                            NEWS2: @news2.Value.Score (@news2.Value.Priority)
                        </span>
                    }
                </div>

                <div class="d-flex align-items-center gap-2">
                    @if (hasVitals)
                    {
                        var v = Model.LatestVitals!;
                        <div class="d-grid gap-1 flex-grow-1" style="grid-template-columns: repeat(5, 1fr);">
                            <div class="vitals-tile">
                                <div class="vitals-label">BP</div>
                                <div class="font-mono-data fw-bold vitals-val">@v.SystolicBp/@v.DiastolicBp</div>
                            </div>
                            <div class="vitals-tile">
                                <div class="vitals-label">HR</div>
                                <div class="font-mono-data fw-bold vitals-val">@v.HeartRate</div>
                            </div>
                            <div class="vitals-tile">
                                <div class="vitals-label">SpO2</div>
                                <div class="font-mono-data fw-bold @(v.Spo2 < 95 ? "text-warning" : "text-success")">@v.Spo2%</div>
                            </div>
                            <div class="vitals-tile">
                                <div class="vitals-label">Temp</div>
                                <div class="font-mono-data fw-bold vitals-val">@v.Temperature&deg;</div>
                            </div>
                            <div class="vitals-tile">
                                <div class="vitals-label">RR</div>
                                <div class="font-mono-data fw-bold vitals-val">@v.RespiratoryRate</div>
                            </div>
                        </div>
                    }

                    <!-- Area-Filled Delta-NEWS2 Sparkline -->
                    @if (ViewBag.DeltaNews2 != null)
                    {
                        var delta = (HospitalManagementSystem.Services.DeltaNews2Result)ViewBag.DeltaNews2;
                        var longVitals = ViewBag.LongitudinalVitals as List<HospitalManagementSystem.Models.PatientVital>;
                        if (longVitals != null && longVitals.Count > 1)
                        {
                            var chrono = longVitals.OrderBy(x => x.CreatedAt).ToList();
                            var points = new List<string>();
                            for (int i = 0; i < chrono.Count; i++)
                            {
                                var s = HospitalManagementSystem.Services.News2Calculator.Calculate(
                                    chrono[i].RespiratoryRate, chrono[i].Spo2, chrono[i].OnSupplementalOxygen,
                                    chrono[i].Temperature, chrono[i].SystolicBp, chrono[i].HeartRate, chrono[i].Consciousness).Score;
                                double px = 4 + (112.0 * i / Math.Max(1, chrono.Count - 1));
                                double py = 22 - Math.Min(18, (s * 1.8));
                                points.Add($"{px.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)},{py.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)}");
                            }
                            var polylineStr = string.Join(" ", points);
                            var firstPt = points.First().Split(',');
                            var lastPt = points.Last().Split(',');
                            var polygonStr = $"{polylineStr} {lastPt[0]},26 {firstPt[0]},26";

                            <div class="d-flex flex-column align-items-end" title="@delta.Message">
                                <svg width="125" height="28" class="overflow-visible" style="background: rgba(0,0,0,0.25); border-radius: 4px; padding: 1px;">
                                    <defs>
                                        <linearGradient id="cockpitSparkGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                                            <stop offset="0%" stop-color="@(delta.IsRapidDeterioration ? "#ef4444" : "#10b981")" stop-opacity="0.45" />
                                            <stop offset="100%" stop-color="@(delta.IsRapidDeterioration ? "#ef4444" : "#10b981")" stop-opacity="0.0" />
                                        </linearGradient>
                                    </defs>
                                    <polygon fill="url(#cockpitSparkGrad)" points="@polygonStr" />
                                    <polyline fill="none" stroke="@(delta.IsRapidDeterioration ? "#ef4444" : "#10b981")" stroke-width="2" points="@polylineStr" />
                                    @foreach (var pt in points)
                                    {
                                        var xy = pt.Split(',');
                                        <circle cx="@xy[0]" cy="@xy[1]" r="2.5" fill="@(delta.IsRapidDeterioration ? "#ef4444" : "#10b981")" />
                                    }
                                </svg>
                                <span class="badge @(delta.IsRapidDeterioration ? "bg-danger" : "bg-secondary bg-opacity-50") mt-1" style="font-size: 0.65rem;">
                                    &Delta;@(delta.Delta > 0 ? $"+{delta.Delta}" : delta.Delta.ToString()) (12h)
                                </span>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- 3-COLUMN WORKSTATION CONTAINER -->
    <div class="cockpit-columns-container">
        <!-- LEFT COLUMN: CLINICAL CONTEXT (AI COPILOT, ACTIVE REGIMENS & HISTORY) -->
        <aside class="cockpit-col-left">
            <!-- 1. AI Clinical Copilot -->
            <div class="pro-card pro-card-compact pro-card-ai mb-3">
                <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom" style="border-color: var(--ai-border) !important;">
                    <div class="d-flex align-items-center gap-1-5">
                        <i class="bi bi-robot text-purple fs-6" style="color: var(--ai-accent);"></i>
                        <h6 class="fw-bold mb-0" style="color: var(--ai-accent);">Clinical Copilot</h6>
                    </div>
                    @if (Model.LatestAiCaseSummary != null)
                    {
                        <span class="badge bg-purple bg-opacity-10 border text-purple" style="font-size: 0.7rem; border-color: var(--ai-border); color: var(--ai-accent);">
                            <i class="bi bi-sparkles me-1"></i>Clinical Briefing
                        </span>
                    }
                </div>

                @if (Model.LatestAiCaseSummary != null)
                {
                    <div class="small" id="aiSummaryTextContainer" style="max-height: 280px; overflow-y: auto;">
                        @{
                            var vdAi = new ViewDataDictionary(ViewData) {
                                ["ReturnUrl"] = Url.Action("Cockpit", "DoctorDashboard", new { id = Model.Appointment.Id }),
                                ["HideActions"] = true
                            };
                        }
                        <partial name="_SuggestionCardBody" model="Model.LatestAiCaseSummary" view-data="vdAi" />
                    </div>
                }
                else
                {
                    <div class="text-center py-3 text-muted" style="font-size: 0.8125rem;">
                        <i class="bi bi-sparkles fs-2 d-block mb-1 opacity-50" style="color: var(--ai-accent);"></i>
                        <span>No AI case summary generated yet.</span>
                    </div>
                }
            </div>

            <!-- 2. Active Prescribed Regimens (Last 30 Days) -->
            <div class="pro-card pro-card-compact mb-3">
                <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                    <h6 class="fw-bold mb-0 text-strong">
                        <i class="bi bi-capsule me-1 text-primary"></i>Active Regimens
                    </h6>
                    <span class="badge bg-secondary bg-opacity-10 text-muted font-mono-data">@Model.ActiveMedications.Count</span>
                </div>

                @if (Model.ActiveMedications.Any())
                {
                    <div class="d-flex flex-column gap-2" style="font-size: 0.8125rem;">
                        @foreach (var med in Model.ActiveMedications)
                        {
                            <div class="p-2 rounded bg-surface-sunken border">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <div class="fw-bold text-strong">@med.MedicineName</div>
                                        <small class="text-muted d-block">@med.GenericName</small>
                                    </div>
                                    <form asp-controller="Prescriptions" asp-action="Discontinue" asp-route-id="@med.PrescriptionId" method="post" class="d-inline" onsubmit="return confirmDiscontinueActiveMed(this, '@med.MedicineName');">
                                        <input type="hidden" name="reason" value="Discontinued during consultation" />
                                        <button type="submit" class="btn btn-outline-warning btn-sm py-0 px-1" title="Discontinue Therapy" style="font-size: 0.7rem;">
                                            Discontinue
                                        </button>
                                    </form>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mt-1 text-muted" style="font-size: 0.72rem;">
                                    <span>Dispensed @med.PrescribedOrDispensedAt.ToLocalTime().ToString("MMM dd")</span>
                                    <span>@(med.DurationDays.HasValue ? $"{med.DurationDays}d course" : "Ongoing")</span>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-2 text-muted" style="font-size: 0.8125rem;">
                        <span>No active regimens in last 30 days.</span>
                    </div>
                }
            </div>

            <!-- 3. Encounter History -->
            <div class="pro-card pro-card-compact mb-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="fw-bold mb-0 text-strong">
                        <i class="bi bi-clock-history me-1 text-primary"></i>Encounter History
                    </h6>
                    <span class="badge bg-secondary bg-opacity-10 text-muted font-mono-data">@pastRecords.Count records</span>
                </div>

                @if (pastRecords.Any())
                {
                    <div class="timeline-track mt-3">
                        @foreach (var rec in pastRecords)
                        {
                            <div class="timeline-item">
                                <div class="timeline-marker"></div>
                                <div class="pro-card pro-card-compact record-highlight-target" id="record-card-@rec.Id" style="font-size: 0.8125rem;">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="fw-bold text-primary font-mono-data">@rec.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")</span>
                                        <small class="text-muted">@(rec.Doctor != null ? rec.Doctor.ToDoctorTitle() : "Staff")</small>
                                    </div>
                                    <div class="fw-semibold text-strong mb-1">@rec.Diagnosis</div>
                                    @if (!string.IsNullOrWhiteSpace(rec.ChiefComplaint))
                                    {
                                        <p class="text-muted mb-1" style="font-size: 0.75rem;">@rec.ChiefComplaint</p>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(rec.Treatment))
                                    {
                                        <div class="p-1 px-2 rounded bg-surface-sunken text-muted" style="font-size: 0.72rem;">
                                            @rec.Treatment
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-3 text-muted">
                        <i class="bi bi-journal-check fs-2 text-muted opacity-50 d-block mb-1"></i>
                        <span class="small">First recorded clinical encounter for this patient.</span>
                    </div>
                }
            </div>
        </aside>

        <!-- FORM WRAPPING ACTIVE CONSULTATION & PRESCRIPTION WORKSPACE (MERGED) -->
        <form asp-action="CompleteConsultation" method="post" id="cockpitForm" class="cockpit-workspace-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="AppointmentId" value="@Model.Appointment.Id" />
            <input type="hidden" name="PatientId" value="@Model.Patient.Id" />
            <input type="hidden" name="SafetyOverrideReason" id="SafetyOverrideReasonInput" />

            <div class="cockpit-col-main d-flex flex-column gap-3">
                <!-- 1. ENCOUNTER DOCUMENTATION & DIAGNOSIS -->
                <div class="pro-card">
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                        <h6 class="fw-bold mb-0 text-strong">
                            <i class="bi bi-journal-medical me-2 text-primary"></i>Encounter Documentation
                        </h6>

                    </div>

                    <div class="bg-surface-sunken p-2 px-3 rounded mb-3 border d-flex align-items-center justify-content-between" style="font-size: 0.8125rem;">
                        <div>
                            <span class="text-muted fw-bold text-uppercase me-2" style="font-size: 0.6875rem;">Queue Reason for Visit:</span>
                            <span class="text-strong fw-semibold">@(string.IsNullOrWhiteSpace(Model.Appointment.ReasonForVisit) ? "Routine Consultation" : Model.Appointment.ReasonForVisit)</span>
                        </div>
                        <small class="text-muted"><i class="bi bi-clock me-1"></i>Slot: @Model.Appointment.AppointmentDatetime.ToLocalTime().ToString("hh:mm tt")</small>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted text-uppercase mb-1" style="font-size: 0.7rem;">Chief Complaints</label>
                            <textarea name="ChiefComplaint" id="chiefComplaintInput" class="form-control form-control-sm" rows="3" placeholder="e.g. High fever for 3 days, sore throat...">@Model.ChiefComplaint</textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted text-uppercase mb-1" style="font-size: 0.7rem;">Clinical Diagnosis <span class="text-danger">*</span></label>
                            <textarea name="Diagnosis" id="diagnosisInput" class="form-control form-control-sm fw-bold" rows="3" placeholder="Clinical assessment / diagnosis (Required)..." required>@Model.Diagnosis</textarea>
                        </div>
                    </div>

                    <div class="mb-1">
                        <label class="form-label small fw-bold text-muted text-uppercase mb-1" style="font-size: 0.7rem;">Treatment Plan &amp; Advice</label>
                        <textarea name="Treatment" id="treatmentInput" class="form-control form-control-sm" rows="3" placeholder="Clinical advice, precautions, follow-up instructions...">@Model.Treatment</textarea>
                    </div>
                </div>

                <!-- 2. PRESCRIPTION FORMULARY & SAFETY NET -->
                <div class="pro-card">
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                        <div class="d-flex align-items-center gap-2">
                            <h6 class="fw-bold mb-0 text-strong">
                                <i class="bi bi-capsule me-2 text-primary"></i>Prescription Formulary
                            </h6>
                            <span class="text-muted small d-none d-sm-inline">(Add medications to prescribe from the formulary)</span>
                        </div>
                        <button type="button" class="btn btn-sm btn-primary py-1 px-3" id="btnAddMedicineRow">
                            <i class="bi bi-plus-circle me-1"></i>Add Medication
                        </button>
                    </div>

                    <!-- Prescribed Medicines Dynamic Rows -->
                    <div id="medicinesListContainer" class="d-flex flex-column gap-2 mb-3"></div>

                    <div id="emptyMedicinesNotice" class="text-center py-4 text-muted bg-surface-sunken rounded border border-dashed mb-3">
                        <i class="bi bi-capsule fs-3 d-block mb-1 text-primary opacity-50"></i>
                        <span class="fw-semibold small d-block">No Medications Added</span>
                        <small class="text-muted">Click "Add Medication" to prescribe items from the formulary.</small>
                    </div>

                    <!-- Real-Time Safety Warnings Container -->
                    <div id="safetyWarningsAlertBox" class="alert alert-warning border-start border-4 border-warning mb-2 py-2 px-3 d-none">
                        <h6 class="fw-bold mb-1 fs-7"><i class="bi bi-shield-exclamation me-1"></i>Clinical Safety Review Required</h6>
                        <ul id="safetyWarningsList" class="small ps-3 mb-2"></ul>
                        <div class="mt-2 pt-2 border-top">
                            <label class="form-label small fw-bold text-dark">Physician Override Rationale <span class="text-danger">*</span></label>
                            <input type="text" id="safetyOverrideReasonField" class="form-control form-control-sm" placeholder="Clinical rationale for overriding warnings..." />
                        </div>
                    </div>
                </div>
            </div>

            <!-- 3. ACTION FOOTER (Pinned at bottom of workspace) -->
            <div class="cockpit-footer-bar d-flex justify-content-between align-items-center bg-card border rounded p-2 px-3 mt-2">
                <button type="button" class="btn btn-outline-secondary" id="btnCompleteNotesOnly">
                    <i class="bi bi-file-earmark-check me-1"></i>Notes Only
                </button>
                <button type="submit" class="btn btn-success px-4 fw-semibold" id="btnSubmitEncounter">
                    <i class="bi bi-check2-circle me-1"></i>Complete Consultation &amp; Save
                </button>
            </div>
        </form>
    </div>
</div>

<!-- HIDDEN MEDICINE ROW TEMPLATE -->
<script type="text/template" id="medicineRowTemplate">
    <div class="medicine-row bg-white border rounded-3 p-3 shadow-sm transition-all hover-border-primary" data-index="{index}">
        <input type="hidden" name="PrescriptionItems.Index" value="{index}" />
        <div class="row g-2 align-items-center mb-2">
            <div class="col-md-7 position-relative">
                <input type="hidden" name="PrescriptionItems[{index}].MedicineId" class="medicine-id-input" required />
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" class="form-control medicine-search-input fw-bold" placeholder="Type medicine or generic name..." autocomplete="off" required />
                </div>
                <div class="list-group position-absolute w-100 shadow mt-1 medicine-search-results" style="z-index: 1060; display: none; max-height: 220px; overflow-y: auto;"></div>
            </div>
            <div class="col-md-4 text-end">
                <span class="stock-badge badge bg-light text-secondary border border-secondary-subtle py-2 px-2 d-none"></span>
            </div>
            <div class="col-md-1 text-end">
                <button type="button" class="btn btn-sm btn-outline-danger rounded-circle remove-row-btn" title="Remove">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        </div>

        <div class="row g-2 align-items-center mb-2">
            <div class="col-md-5">
                <label class="form-label small text-muted mb-0" style="font-size: 0.72rem;">Dose (Morn + Aft + Eve)</label>
                <div class="input-group input-group-sm">
                    <input type="number" step="0.5" min="0" name="PrescriptionItems[{index}].DoseMorning" class="form-control text-center px-1" value="1" title="Morning" />
                    <span class="input-group-text px-1 text-muted">+</span>
                    <input type="number" step="0.5" min="0" name="PrescriptionItems[{index}].DoseAfternoon" class="form-control text-center px-1" value="0" title="Afternoon" />
                    <span class="input-group-text px-1 text-muted">+</span>
                    <input type="number" step="0.5" min="0" name="PrescriptionItems[{index}].DoseEvening" class="form-control text-center px-1" value="1" title="Evening" />
                    <select name="PrescriptionItems[{index}].DoseUnit" class="form-select flex-grow-0" style="width: 80px;">
                        <option value="Tablet" selected>Tab</option>
                        <option value="Capsule">Cap</option>
                        <option value="Ml">ml</option>
                        <option value="Drops">Drops</option>
                        <option value="Puff">Puff</option>
                    </select>
                </div>
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted mb-0" style="font-size: 0.72rem;">Quantity</label>
                <input type="number" name="PrescriptionItems[{index}].Quantity" class="form-control form-control-sm text-center qty-input" min="1" value="10" required />
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted mb-0" style="font-size: 0.72rem;">Days</label>
                <input type="number" name="PrescriptionItems[{index}].DurationDays" class="form-control form-control-sm text-center" min="1" value="5" />
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted mb-0" style="font-size: 0.72rem;">Route</label>
                <select name="PrescriptionItems[{index}].Route" class="form-select form-select-sm">
                    <option value="Oral" selected>Oral</option>
                    <option value="IV">IV</option>
                    <option value="IM">IM</option>
                    <option value="Topical">Topical</option>
                    <option value="Inhalation">Inhalation</option>
                </select>
            </div>
        </div>

        <div class="row g-2">
            <div class="col-12">
                <input type="text" name="PrescriptionItems[{index}].Instructions" class="form-control form-control-sm" placeholder="Instructions (e.g., Take after meals. Avoid dairy products...)" />
            </div>
        </div>
    </div>
</script>

<!-- CANCEL / WALKOUT MODAL -->
<form id="cancelWalkoutForm" asp-action="CancelConsultation" method="post" style="display:none;">
    <input type="hidden" name="id" id="cancelAppointmentIdInput" />
    <input type="hidden" name="reason" id="cancelReasonInput" />
</form>

@section Scripts {
    <script>
        // Formulary dataset for fast client autocomplete
        var allMedicines = [
            @foreach (var m in Model.FormularyMedicines)
            {
                <text>{ id: @m.Id, name: '@Html.Raw(m.Name.Replace("'", "\\'"))', generic: '@Html.Raw(m.GenericName.Replace("'", "\\'"))', display: '@Html.Raw(m.DisplayName.Replace("'", "\\'"))', stock: @m.StockQuantity },</text>
            }
        ];

        var rowIndex = 0;

        function refreshEmptyState() {
            var rowCount = $('#medicinesListContainer .medicine-row').length;
            if (rowCount === 0) {
                $('#emptyMedicinesNotice').removeClass('d-none');
            } else {
                $('#emptyMedicinesNotice').addClass('d-none');
            }
        }

        function reindexRows() {
            $('#medicinesListContainer .medicine-row').each(function(i) {
                $(this).attr('data-index', i);
                $(this).find('input[name="PrescriptionItems.Index"]').val(i);
                $(this).find('input, select').each(function() {
                    var name = $(this).attr('name');
                    if (name && name !== 'PrescriptionItems.Index') {
                        name = name.replace(/\[\d+\]/, '[' + i + ']');
                        $(this).attr('name', name);
                    }
                });
            });
        }

        function getSelectedMedicineIds() {
            var ids = [];
            $('#medicinesListContainer .medicine-id-input').each(function() {
                var val = $(this).val();
                if (val) ids.push(parseInt(val));
            });
            return ids;
        }

        $('#btnAddMedicineRow').click(function() {
            var template = $('#medicineRowTemplate').html().replace(/{index}/g, rowIndex);
            var $row = $(template);
            $row.hide();
            $('#medicinesListContainer').append($row);
            $row.slideDown(200);
            rowIndex++;
            refreshEmptyState();
        });

        $(document).on('click', '.remove-row-btn', function() {
            var $row = $(this).closest('.medicine-row');
            $row.slideUp(150, function() {
                $(this).remove();
                reindexRows();
                refreshEmptyState();
                checkRealTimeSafety();
            });
        });

        // Autocomplete search
        $(document).on('input', '.medicine-search-input', function() {
            var query = $(this).val().toLowerCase().trim();
            var $container = $(this).closest('.medicine-row').find('.medicine-search-results');
            var $row = $(this).closest('.medicine-row');

            if (!query) {
                $container.hide().empty();
                return;
            }

            var selectedIds = getSelectedMedicineIds();

            var matches = allMedicines.filter(function(m) {
                return m.name.toLowerCase().indexOf(query) !== -1 || m.generic.toLowerCase().indexOf(query) !== -1;
            });

            $container.empty();
            if (matches.length === 0) {
                $container.append('<div class="list-group-item text-muted small py-2 text-center">No formulary match found</div>');
            } else {
                matches.slice(0, 10).forEach(function(m) {
                    var isAlreadySelected = selectedIds.includes(m.id);
                    var isOutOfStock = m.stock <= 0;
                    var stockBadge = !isOutOfStock
                        ? '<span class="badge bg-light text-secondary border">Stock: ' + m.stock + '</span>'
                        : '<span class="badge bg-danger text-white"><i class="bi bi-x-circle me-1"></i>Out of Stock</span>';

                    var altHtml = '';
                    if (isOutOfStock) {
                        var alt = allMedicines.find(function(a) {
                            return a.generic && m.generic && a.generic.toLowerCase() === m.generic.toLowerCase() && a.stock > 0 && a.id !== m.id;
                        });
                        if (alt) {
                            altHtml = '<div class="small text-success mt-1"><i class="bi bi-arrow-right-circle me-1"></i>In-stock alternative: <strong>' + alt.name + '</strong> (' + alt.stock + ' in stock)</div>';
                        }
                    }

                    var $item = $('<a href="#" class="list-group-item list-group-item-action py-2"></a>')
                        .html('<div class="d-flex justify-content-between align-items-center"><div><strong>' + m.name + '</strong> <small class="text-muted">(' + m.generic + ')</small></div> ' + stockBadge + '</div>' + altHtml)
                        .click(function(e) {
                            e.preventDefault();
                            if (isAlreadySelected) {
                                Swal.fire({
                                    icon: 'warning',
                                    title: 'Medicine Already Added',
                                    text: m.name + ' is already present in this prescription. Please adjust its dose or quantity instead.'
                                });
                                $container.hide();
                                return;
                            }

                            $row.find('.medicine-id-input').val(m.id);
                            $row.find('.medicine-search-input').val(m.name);
                            var $badge = $row.find('.stock-badge');
                            $badge.html('<i class="bi bi-box-seam me-1"></i>Stock: ' + m.stock).removeClass('d-none');
                            if (m.stock <= 0) {
                                $badge.addClass('bg-danger text-white').removeClass('bg-light text-secondary');
                            } else {
                                $badge.removeClass('bg-danger text-white').addClass('bg-light text-secondary');
                            }
                            $container.hide();
                            checkRealTimeSafety();
                        });

                    $container.append($item);
                });
            }
            $container.show();
        });

        // Hide results dropdown on click outside
        $(document).click(function(e) {
            if (!$(e.target).closest('.medicine-row').length) {
                $('.medicine-search-results').hide();
            }
        });

        // Real-Time Safety Check via fetch
        function checkRealTimeSafety() {
            var items = [];
            $('#medicinesListContainer .medicine-row').each(function() {
                var medId = $(this).find('.medicine-id-input').val();
                var qty = $(this).find('.qty-input').val();
                var unit = $(this).find('select[name$=".DoseUnit"]').val();
                if (medId) {
                    items.push({
                        medicineId: parseInt(medId),
                        quantity: parseInt(qty) || 1,
                        doseUnit: unit || "Tablet"
                    });
                }
            });

            if (items.length === 0) {
                $('#safetyWarningsAlertBox').addClass('d-none');
                return;
            }

            var token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '@Url.Action("CheckSafety", "Prescriptions")',
                type: 'POST',
                data: {
                    patientId: @Model.Patient.Id,
                    itemsJson: JSON.stringify(items),
                    __RequestVerificationToken: token
                },
                success: function(response) {
                    if (response && response.warnings && response.warnings.length > 0) {
                        var $list = $('#safetyWarningsList').empty();
                        response.warnings.forEach(function(w) {
                            var isCritical = w.severity === "Critical";
                            var colorClass = isCritical ? "text-danger fw-bold" : "text-dark";
                            $list.append('<li class="' + colorClass + '"><strong>' + w.category + ':</strong> ' + w.message + '</li>');
                        });
                        $('#safetyWarningsAlertBox').removeClass('d-none');
                    } else {
                        $('#safetyWarningsAlertBox').addClass('d-none');
                    }
                }
            });
        }



        // Complete Notes Only (Clears empty medicine rows and submits)
        $('#btnCompleteNotesOnly').click(function() {
            $('#medicinesListContainer').empty();
            refreshEmptyState();
            $('#btnSubmitEncounter').click();
        });

        // Form Submit & Double-Click Prevention with Unsaved Changes Guard
        var isEncounterSubmitting = false;
        $('#cockpitForm').on('submit', function(e) {
            reindexRows();
            var hasWarnings = !$('#safetyWarningsAlertBox').hasClass('d-none');
            if (hasWarnings) {
                var overrideVal = $('#safetyOverrideReasonField').val().trim();
                if (!overrideVal) {
                    e.preventDefault();
                    Swal.fire({
                        icon: 'warning',
                        title: 'Override Reason Required',
                        text: 'Safety warnings were identified for this prescription. You must provide a clinical rationale in the box to proceed.'
                    });
                    $('#safetyOverrideReasonField').focus();
                    return false;
                }
                $('#SafetyOverrideReasonInput').val(overrideVal);
            }

            isEncounterSubmitting = true;
            // Disable submit button immediately to prevent double-click race
            $('#btnSubmitEncounter').prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Saving Encounter...');
        });

        // Warn if navigating away with unsaved consultation drafts
        window.addEventListener('beforeunload', function (e) {
            if (isEncounterSubmitting) return;
            var cc = $('#ChiefComplaints').val();
            var cd = $('#ClinicalDiagnosis').val();
            var tp = $('#TreatmentPlan').val();
            var medRows = $('#medicinesListContainer .medicine-row').length;
            if ((cc && cc.trim().length > 0) || (cd && cd.trim().length > 0) || (tp && tp.trim().length > 0) || medRows > 0) {
                e.preventDefault();
                e.returnValue = '';
            }
        });

        function confirmDiscontinueActiveMed(form, medName) {
            Swal.fire({
                title: 'Discontinue ' + medName + '?',
                text: 'This will halt active therapy and exclude it from future drug interaction warnings.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ffc107',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, discontinue'
            }).then((result) => {
                if (result.isConfirmed) {
                    form.submit();
                }
            });
            return false;
        }

        function cancelWalkout(appointmentId) {
            Swal.fire({
                title: 'Patient Walkout / Cancel?',
                text: 'Record reason for cancelling consultation:',
                input: 'text',
                inputPlaceholder: 'e.g. Patient left chamber, declined examination...',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Cancel Consultation',
                inputValidator: (val) => {
                    if (!val || !val.trim()) return 'Please provide a cancellation reason.';
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    $('#cancelAppointmentIdInput').val(appointmentId);
                    $('#cancelReasonInput').val(result.value);
                    $('#cancelWalkoutForm').submit();
                }
            });
        }
    </script>
}
