@model IEnumerable<HospitalManagementSystem.Models.User>

@{
    ViewData["Title"] = "My Assistant";
}

<div class="mb-5 border-bottom pb-4 d-flex justify-content-between align-items-center">
    <div>
        <h2 class="mb-1">My Assistants</h2>
        <p class="text-muted mb-0">Manage your assigned assistants and their credentials.</p>
    </div>
    <!-- Button to trigger modal for adding new assistant -->
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createAssistantModal">
        <i class="bi bi-person-plus-fill me-1"></i> Add Assistant
    </button>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger mb-4">@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success mb-4">@TempData["Success"]</div>
}

<div class="row g-4">
    @if (Model != null && Model.Any())
    {
        foreach (var assistant in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="pro-card border-top border-4 border-primary h-100 d-flex flex-column p-4 shadow-sm">
                    <!-- Top Bar: Avatar & Action Toolbar in Normal Flow -->
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="icon-box bg-primary text-white rounded-circle d-flex justify-content-center align-items-center shadow-sm flex-shrink-0" style="width: 48px; height: 48px;">
                            <i class="bi bi-person-badge fs-4"></i>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1 shadow-sm" data-bs-toggle="modal" data-bs-target="#editAssistantModal-@assistant.Id" title="Edit Assistant">
                                <i class="bi bi-pencil-fill"></i> <span>Edit</span>
                            </button>
                            <form asp-action="FireAssistant" asp-route-id="@assistant.Id" method="post" onsubmit="return confirm('Are you sure you want to fire @assistant.FullName? This will permanently delete their account.');" class="d-inline mb-0">
                                <button type="submit" class="btn btn-sm btn-outline-danger d-flex align-items-center gap-1 shadow-sm" title="Fire Assistant">
                                    <i class="bi bi-trash-fill"></i> <span>Fire</span>
                                </button>
                            </form>
                        </div>
                    </div>

                    <!-- Assistant Identity (Full Width, No Overlap Risk) -->
                    <div class="mb-3">
                        <h5 class="mb-1 fw-bold text-strong" title="@assistant.FullName">@assistant.FullName</h5>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                            <i class="bi bi-shield-check me-1"></i>Assigned Assistant
                        </span>
                    </div>
                    
                    <!-- Credentials Box -->
                    <div class="bg-light p-3 rounded-3 mb-3 border">
                        <div class="mb-2">
                            <label class="text-muted small text-uppercase fw-bold mb-1 d-block">
                                <i class="bi bi-person me-1"></i> Username
                            </label>
                            <p class="fs-6 mb-0 font-monospace text-strong user-select-all">@assistant.Username</p>
                        </div>
                        <div class="mb-0">
                            <label class="text-muted small text-uppercase fw-bold mb-1 d-block">
                                <i class="bi bi-key me-1"></i> Password
                            </label>
                            <div class="d-flex flex-wrap align-items-baseline gap-2">
                                <span class="fs-6 font-monospace text-muted">••••••••</span>
                                <small class="text-muted fst-italic">(set by you — use Edit to reset)</small>
                            </div>
                        </div>
                    </div>

                    <!-- Card Footer: Metadata and Status -->
                    <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                        <small class="text-muted d-flex align-items-center gap-1">
                            <i class="bi bi-calendar3"></i> Hired: @assistant.CreatedAt.ToString("MMM dd, yyyy")
                        </small>
                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                            <i class="bi bi-dot"></i>Active
                        </span>
                    </div>
                </div>
            </div>

            <!-- Edit Assistant Modal -->
            <div class="modal fade" id="editAssistantModal-@assistant.Id" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content border-0 shadow">
                        <div class="modal-header bg-secondary text-white border-0 py-3">
                            <h5 class="modal-title"><i class="bi bi-pencil-square me-2"></i>Edit Assistant Details</h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <form asp-action="UpdateAssistant" method="post">
                            <input type="hidden" name="id" value="@assistant.Id" />
                            <div class="modal-body p-4">
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Full Name <span class="text-danger">*</span></label>
                                    <input type="text" name="fullName" class="form-control" value="@assistant.FullName" required />
                                </div>
                                
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Username (Login ID) <span class="text-danger">*</span></label>
                                    <input type="text" name="username" class="form-control" value="@assistant.Username" required />
                                </div>

                                <div class="mb-2">
                                    <label class="form-label fw-bold">New Password</label>
                                    <input type="text" name="password" class="form-control" placeholder="Leave blank to keep current password" />
                                </div>
                            </div>
                            <div class="modal-footer bg-light border-0">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-primary px-4">Save Changes</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center py-5">
            <i class="bi bi-people text-muted mb-3 d-block" style="font-size: 4rem;"></i>
            <h4 class="text-secondary">No Assistants Found</h4>
            <p class="text-muted">You currently don't have any assistants assigned to you.</p>
            <button type="button" class="btn btn-outline-primary mt-2" data-bs-toggle="modal" data-bs-target="#createAssistantModal">
                Hire Your First Assistant
            </button>
        </div>
    }
</div>

<!-- Create Assistant Modal -->
<div class="modal fade" id="createAssistantModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white border-0 py-3">
                <h5 class="modal-title"><i class="bi bi-person-plus-fill me-2"></i>Hire New Assistant</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="CreateAssistant" method="post">
                <div class="modal-body p-4">
                    <div class="alert alert-info border-0 shadow-sm mb-4 pb-2 pt-3">
                        <p class="mb-0 small"><i class="bi bi-info-circle me-1"></i> When you create this account, hand the <b>Username</b> and <b>Password</b> to your new assistant. They will use the <b>Real Login</b> portal to access their dashboard.</p>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Full Name <span class="text-danger">*</span></label>
                        <input type="text" name="fullName" class="form-control" placeholder="e.g., Jane Doe" required />
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold">Username <span class="text-danger">*</span></label>
                        <input type="text" name="username" class="form-control" placeholder="Unique login ID" required />
                    </div>

                    <div class="mb-2">
                        <label class="form-label fw-bold">Password <span class="text-danger">*</span></label>
                        <input type="text" name="password" class="form-control" placeholder="Choose a password" required />
                    </div>
                </div>
                <div class="modal-footer bg-light border-0">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4">Hire Assistant</button>
                </div>
            </form>
        </div>
    </div>
</div>
