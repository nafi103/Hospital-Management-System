@model HospitalManagementSystem.Models.PatientVital
@using HospitalManagementSystem.Models
@{
    ViewData["Title"] = "Record Vitals";
    var appointment = (Appointment)ViewBag.Appointment;
}

<div class="mb-4 border-bottom pb-3">
    <a asp-controller="Appointments" asp-action="Index" class="text-decoration-none text-muted mb-2 d-inline-block">
        <i class="bi bi-arrow-left"></i> Back to Queue
    </a>
    <h2 class="mb-1">Record Vitals</h2>
    <p class="text-muted mb-0">
        For <span class="fw-medium">@(string.IsNullOrEmpty(appointment.Patient?.FullName) ? "Baby of " + appointment.Patient?.EmergencyContactName : appointment.Patient?.FullName)</span>
        &middot; UHID: @appointment.Patient?.Uhid
    </p>
</div>

<div class="row">
    <div class="col-md-8 mx-auto">
        <div class="pro-card">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <input type="hidden" asp-for="AppointmentId" />
                <input type="hidden" asp-for="PatientId" />

                <h5 class="card-title text-primary mb-4 border-bottom pb-2">Vital Signs</h5>
                <div class="row g-4 mb-4">
                    <div class="col-md-4">
                        <label asp-for="SystolicBp" class="form-label fw-medium">Systolic BP (mmHg) <span class="text-danger">*</span></label>
                        <input asp-for="SystolicBp" type="number" min="40" max="260" class="form-control" placeholder="e.g. 120 (40-260)" required />
                        <span asp-validation-for="SystolicBp" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="DiastolicBp" class="form-label fw-medium">Diastolic BP (mmHg) <span class="text-danger">*</span></label>
                        <input asp-for="DiastolicBp" type="number" min="20" max="180" class="form-control" placeholder="e.g. 80 (20-180)" required />
                        <span asp-validation-for="DiastolicBp" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="HeartRate" class="form-label fw-medium">Heart Rate (bpm) <span class="text-danger">*</span></label>
                        <input asp-for="HeartRate" type="number" min="25" max="250" class="form-control" placeholder="e.g. 78 (25-250)" required />
                        <span asp-validation-for="HeartRate" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="RespiratoryRate" class="form-label fw-medium">Respiratory Rate (breaths/min) <span class="text-danger">*</span></label>
                        <input asp-for="RespiratoryRate" type="number" min="4" max="60" class="form-control" placeholder="e.g. 16 (4-60)" required />
                        <span asp-validation-for="RespiratoryRate" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Spo2" class="form-label fw-medium">SpO2 (%) <span class="text-danger">*</span></label>
                        <input asp-for="Spo2" type="number" step="0.1" min="50" max="100" class="form-control" placeholder="e.g. 98 (50-100)" required />
                        <span asp-validation-for="Spo2" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Temperature" class="form-label fw-medium">Temperature (&deg;C) <span class="text-danger">*</span></label>
                        <input asp-for="Temperature" type="number" step="0.1" min="30.0" max="45.0" class="form-control" placeholder="e.g. 37.0 (30.0-45.0)" required />
                        <span asp-validation-for="Temperature" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <label asp-for="Consciousness" class="form-label fw-medium">Consciousness (ACVPU) <span class="text-danger">*</span></label>
                        <select asp-for="Consciousness" class="form-select" asp-items="Html.GetEnumSelectList<ConsciousnessLevel>()"></select>
                        <span asp-validation-for="Consciousness" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="BloodSugar" class="form-label fw-medium">Blood Sugar (mmol/L)</label>
                        <input asp-for="BloodSugar" type="number" step="0.1" min="0.5" max="50.0" class="form-control" placeholder="Optional (0.5-50.0)" />
                        <span asp-validation-for="BloodSugar" class="text-danger small"></span>
                    </div>
                    <div class="col-md-12">
                        <div class="form-check form-switch fs-5">
                            <input class="form-check-input" type="checkbox" role="switch" asp-for="OnSupplementalOxygen" />
                            <label class="form-check-label fw-medium" asp-for="OnSupplementalOxygen">Patient is on supplemental oxygen</label>
                        </div>
                    </div>
                </div>

                @if (appointment.Patient?.IsChild == true)
                {
                    <div class="alert alert-warning border-0 bg-warning bg-opacity-10 mb-4 d-flex align-items-start">
                        <i class="bi bi-shield-exclamation fs-4 text-warning me-3 mt-1"></i>
                        <div>
                            <strong class="text-warning-emphasis d-block mb-1">Pediatric Safety Advisory:</strong>
                            <span class="small text-muted">
                                This patient is a pediatric patient (child/minor). Adult NEWS2 score is clinically invalid and contraindicated for minors due to different physiological baselines. Automated NEWS2 calculation is withheld; clinical priority must be determined using pediatric protocols (PEWS).
                            </span>
                        </div>
                    </div>
                }
                else
                {
                    <!-- LIVE DYNAMIC NEWS2 TRIAGE GAUGE -->
                    <div class="pro-card pro-card-compact mb-4 border-2" id="news2LiveGaugeCard" style="border-color: rgba(16, 185, 129, 0.4) !important;">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-heart-pulse-fill text-success fs-5" id="news2Icon"></i>
                                <span class="fw-bold text-strong fs-7">Live National Early Warning Score (NEWS2)</span>
                            </div>
                            <span class="badge bg-success text-white font-mono-data px-2 py-1 fs-7" id="news2ScoreBadge">
                                SCORE: 0 &bull; NORMAL
                            </span>
                        </div>

                        <!-- Progress Bar Gauge -->
                        <div class="progress mb-2" style="height: 10px; background-color: var(--surface-sunken);">
                            <div class="progress-bar bg-success transition-all" id="news2ProgressBar" role="progressbar" style="width: 5%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="20"></div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center text-muted font-mono-data" style="font-size: 0.7rem;">
                            <span>0 (Low Risk)</span>
                            <span>5 (Urgent / Medium)</span>
                            <span>7+ (Emergency / High)</span>
                            <span>20</span>
                        </div>
                        <small class="text-muted d-block mt-2" id="news2ClinicalGuidance">
                            <i class="bi bi-info-circle me-1"></i>Routine clinical care: Ward monitoring as per standard hospital protocols.
                        </small>
                    </div>
                }

                <div class="d-grid">
                    <button type="submit" class="btn btn-primary btn-lg">
                        <i class="bi bi-clipboard2-pulse me-1"></i> Save Vitals &amp; Determine Priority
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    @if (appointment.Patient?.IsChild != true)
    {
        <script>
            (function () {
                const sysInput = document.getElementById("SystolicBp");
                const hrInput = document.getElementById("HeartRate");
                const rrInput = document.getElementById("RespiratoryRate");
                const spo2Input = document.getElementById("Spo2");
                const tempInput = document.getElementById("Temperature");
                const o2Input = document.getElementById("OnSupplementalOxygen");
                const acvpuInput = document.getElementById("Consciousness");

                const scoreBadge = document.getElementById("news2ScoreBadge");
                const progressBar = document.getElementById("news2ProgressBar");
                const guidance = document.getElementById("news2ClinicalGuidance");
                const card = document.getElementById("news2LiveGaugeCard");
                const icon = document.getElementById("news2Icon");

                function calcNews2() {
                    let score = 0;
                    let hasSingle3 = false;

                    // 1. Respiration Rate
                    const rr = parseFloat(rrInput.value);
                    if (!isNaN(rr)) {
                        let sub = 0;
                        if (rr <= 8) sub = 3;
                        else if (rr >= 9 && rr <= 11) sub = 1;
                        else if (rr >= 12 && rr <= 20) sub = 0;
                        else if (rr >= 21 && rr <= 24) sub = 2;
                        else if (rr >= 25) sub = 3;
                        score += sub;
                        if (sub === 3) hasSingle3 = true;
                    }

                    // 2. SpO2
                    const spo2 = parseFloat(spo2Input.value);
                    if (!isNaN(spo2)) {
                        let sub = 0;
                        if (spo2 <= 91) sub = 3;
                        else if (spo2 >= 92 && spo2 <= 93) sub = 2;
                        else if (spo2 >= 94 && spo2 <= 95) sub = 1;
                        else sub = 0;
                        score += sub;
                        if (sub === 3) hasSingle3 = true;
                    }

                    // 3. Supplemental Oxygen
                    if (o2Input && o2Input.checked) {
                        score += 2;
                    }

                    // 4. Systolic BP
                    const sbp = parseFloat(sysInput.value);
                    if (!isNaN(sbp)) {
                        let sub = 0;
                        if (sbp <= 90) sub = 3;
                        else if (sbp >= 91 && sbp <= 100) sub = 2;
                        else if (sbp >= 101 && sbp <= 110) sub = 1;
                        else if (sbp >= 111 && sbp <= 219) sub = 0;
                        else if (sbp >= 220) sub = 3;
                        score += sub;
                        if (sub === 3) hasSingle3 = true;
                    }

                    // 5. Pulse / Heart Rate
                    const hr = parseFloat(hrInput.value);
                    if (!isNaN(hr)) {
                        let sub = 0;
                        if (hr <= 40) sub = 3;
                        else if (hr >= 41 && hr <= 50) sub = 1;
                        else if (hr >= 51 && hr <= 90) sub = 0;
                        else if (hr >= 91 && hr <= 110) sub = 1;
                        else if (hr >= 111 && hr <= 130) sub = 2;
                        else if (hr >= 131) sub = 3;
                        score += sub;
                        if (sub === 3) hasSingle3 = true;
                    }

                    // 6. Consciousness (ACVPU)
                    if (acvpuInput) {
                        const val = parseInt(acvpuInput.value);
                        // Alert is usually 0, any other is 3
                        if (val > 0) {
                            score += 3;
                            hasSingle3 = true;
                        }
                    }

                    // 7. Temperature
                    const temp = parseFloat(tempInput.value);
                    if (!isNaN(temp)) {
                        let sub = 0;
                        if (temp <= 35.0) sub = 3;
                        else if (temp >= 35.1 && temp <= 36.0) sub = 1;
                        else if (temp >= 36.1 && temp <= 38.0) sub = 0;
                        else if (temp >= 38.1 && temp <= 39.0) sub = 1;
                        else if (temp >= 39.1) sub = 2;
                        score += sub;
                        if (sub === 3) hasSingle3 = true;
                    }

                    // Cap visual score at 20
                    const clamped = Math.min(20, score);
                    const pct = Math.max(5, (clamped / 20) * 100);
                    progressBar.style.width = pct + "%";

                    if (score >= 7) {
                        // High / Emergency Risk
                        progressBar.className = "progress-bar bg-danger";
                        scoreBadge.className = "badge bg-danger text-white font-mono-data px-2 py-1 fs-7 animate-pulse";
                        scoreBadge.innerHTML = '<i class="bi bi-exclamation-octagon-fill me-1"></i>SCORE: ' + score + ' &bull; EMERGENCY';
                        card.style.borderColor = "rgba(239, 68, 68, 0.6)";
                        icon.className = "bi bi-exclamation-triangle-fill text-danger fs-5";
                        guidance.innerHTML = '<strong class="text-danger"><i class="bi bi-exclamation-octagon-fill me-1"></i>Emergency Triage Triggered:</strong> Immediate clinical review required. Continuous vital sign monitoring and resuscitation team alert advised.';
                    } else if (score >= 5 || hasSingle3) {
                        // Medium / Urgent Risk
                        progressBar.className = "progress-bar bg-warning";
                        scoreBadge.className = "badge bg-warning text-dark font-mono-data px-2 py-1 fs-7";
                        scoreBadge.innerHTML = '<i class="bi bi-exclamation-triangle-fill me-1"></i>SCORE: ' + score + ' &bull; URGENT';
                        card.style.borderColor = "rgba(245, 158, 11, 0.6)";
                        icon.className = "bi bi-exclamation-triangle text-warning fs-5";
                        guidance.innerHTML = '<strong class="text-warning-emphasis"><i class="bi bi-exclamation-circle me-1"></i>Urgent Review Triggered:</strong> Urgent assessment by attending doctor recommended. Escalate monitoring frequency to hourly.';
                    } else {
                        // Low / Normal Risk
                        progressBar.className = "progress-bar bg-success";
                        scoreBadge.className = "badge bg-success text-white font-mono-data px-2 py-1 fs-7";
                        scoreBadge.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i>SCORE: ' + score + ' &bull; LOW RISK';
                        card.style.borderColor = "rgba(16, 185, 129, 0.4)";
                        icon.className = "bi bi-heart-pulse-fill text-success fs-5";
                        guidance.innerHTML = '<i class="bi bi-info-circle me-1"></i>Routine clinical care: Ward monitoring as per standard hospital protocols.';
                    }
                }

                [sysInput, hrInput, rrInput, spo2Input, tempInput, o2Input, acvpuInput].forEach(el => {
                    if (el) {
                        el.addEventListener("input", calcNews2);
                        el.addEventListener("change", calcNews2);
                    }
                });

                // Initial calculation on load
                calcNews2();
            })();
        </script>
    }
}
