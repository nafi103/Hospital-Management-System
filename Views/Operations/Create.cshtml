@model HospitalManagementSystem.Models.ViewModels.OperationCreateViewModel

@{
    ViewData["Title"] = "Schedule Surgical Operation";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
            <div>
                <h2 class="mb-1 fw-bold"><i class="bi bi-calendar-plus text-primary me-2"></i>Schedule Surgical Operation</h2>
                <p class="text-muted mb-0">Multi-resource scheduling with simultaneous surgeon, OT room, and recovery bed validation.</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back to Theatre Schedule
            </a>
        </div>

        <div class="alert alert-info border-info-subtle d-flex align-items-start gap-3 mb-4">
            <i class="bi bi-shield-check fs-3 text-info mt-1"></i>
            <div>
                <h6 class="fw-bold mb-1">Multi-Resource Conflict Prevention Active</h6>
                <p class="mb-0 small">
                    This scheduling workflow enforces three simultaneous constraints: (1) Surgeon has no conflicting outpatient appointments or surgeries; (2) Operating Theatre is unbooked; and (3) An ICU or Cabin recovery bed is earmarked for post-op transfer.
                </p>
            </div>
        </div>

        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="PatientId" class="form-label fw-semibold">Patient <span class="text-danger">*</span></label>
                            <select asp-for="PatientId" class="form-select" asp-items="ViewBag.Patients">
                                <option value="">-- Select Patient --</option>
                            </select>
                            <span asp-validation-for="PatientId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="SurgeonId" class="form-label fw-semibold">Lead Surgeon <span class="text-danger">*</span></label>
                            <select asp-for="SurgeonId" class="form-select" asp-items="ViewBag.Surgeons">
                                <option value="">-- Select Surgeon --</option>
                            </select>
                            <span asp-validation-for="SurgeonId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="OtRoom" class="form-label fw-semibold">Operating Theatre Room <span class="text-danger">*</span></label>
                            <select asp-for="OtRoom" class="form-select">
                                @if (ViewBag.OtRooms != null)
                                {
                                    foreach (string room in ViewBag.OtRooms)
                                    {
                                        <option value="@room">@room</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="OtRoom" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="OperationDatetime" class="form-label fw-semibold">Scheduled Date & Time (UTC) <span class="text-danger">*</span></label>
                            <input asp-for="OperationDatetime" class="form-control" type="datetime-local" />
                            <span asp-validation-for="OperationDatetime" class="text-danger small"></span>
                            <small class="text-muted">Standard surgical slot allocation: 2 hours.</small>
                        </div>

                        <div class="col-12">
                            <label asp-for="RecoveryBedId" class="form-label fw-semibold">Post-Op Recovery Bed (ICU / Cabin) <span class="text-danger">*</span></label>
                            <select asp-for="RecoveryBedId" class="form-select" asp-items="ViewBag.RecoveryBeds">
                                <option value="">-- Select Available ICU or Cabin Bed --</option>
                            </select>
                            <span asp-validation-for="RecoveryBedId" class="text-danger small"></span>
                            <small class="text-muted">Earmarks the bed automatically for inpatient recovery via BedTransfers.</small>
                        </div>

                        <div class="col-12">
                            <label asp-for="PreparationChecklist" class="form-label fw-semibold">Pre-Op Preparation Checklist & Protocol</label>
                            <textarea asp-for="PreparationChecklist" class="form-control" rows="3" placeholder="Enter pre-op protocol, fasting, allergy notes, anesthesia clearance..."></textarea>
                            <span asp-validation-for="PreparationChecklist" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check2-circle me-1"></i> Verify Constraints & Book Theatre
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
