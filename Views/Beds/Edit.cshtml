@model HospitalManagementSystem.Models.Bed

@{
    ViewData["Title"] = "Edit Bed";
}

<div class="mb-4 border-bottom pb-3">
    <a asp-action="Index" class="text-decoration-none text-muted mb-2 d-inline-block">
        <i class="bi bi-arrow-left"></i> Back to Directory
    </a>
    <h2 class="mb-1">Edit Bed Details</h2>
</div>

<div class="row">
    <div class="col-md-6 mx-auto">
        <div class="pro-card">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="CreatedAt" />
                
                <div class="mb-3">
                    <label asp-for="BedNumber" class="form-label fw-medium">Bed Number / Name <span class="text-danger">*</span></label>
                    <input asp-for="BedNumber" class="form-control" placeholder="e.g. ICU-01, WARD-12" required />
                    <span asp-validation-for="BedNumber" class="text-danger small"></span>
                </div>
                
                <div class="mb-3">
                    <label asp-for="Category" class="form-label fw-medium">Category <span class="text-danger">*</span></label>
                    <select asp-for="Category" class="form-select" asp-items="Html.GetEnumSelectList<HospitalManagementSystem.Models.BedCategory>()" required>
                    </select>
                    <span asp-validation-for="Category" class="text-danger small"></span>
                </div>
                
                <div class="mb-4">
                    <label asp-for="DailyRate" class="form-label fw-medium">Daily Rate (৳) <span class="text-danger">*</span></label>
                    <input asp-for="DailyRate" type="number" step="0.01" class="form-control" required />
                    <span asp-validation-for="DailyRate" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Index" class="btn btn-light border">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
