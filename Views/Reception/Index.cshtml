@{
    ViewData["Title"] = "Front Desk";
}

<div class="mb-5 border-bottom pb-4">
    <h2 class="mb-1">Front Desk</h2>
    <p class="text-muted mb-0">Today's queue, bed occupancy, and outstanding bills at a glance.</p>
</div>

<partial name="_ActionSuccessBanner" />

<div class="row g-4 mb-5">
    <div class="col-md-3">
        <div class="pro-card h-100 text-center border-start border-4 border-primary">
            <h6 class="text-muted text-uppercase mb-2">Today's Appointments</h6>
            <h2 class="fw-bold text-primary mb-0">@ViewBag.TotalToday</h2>
            <small class="text-muted">@ViewBag.WaitingToday waiting &middot; @ViewBag.InConsultationToday with doctor &middot; @ViewBag.CompletedToday done</small>
        </div>
    </div>
    <div class="col-md-3">
        <div class="pro-card h-100 text-center border-start border-4 border-info">
            <h6 class="text-muted text-uppercase mb-2">Bed Occupancy</h6>
            <h2 class="fw-bold text-info mb-0">@ViewBag.OccupiedBeds <span class="fs-6 fw-normal text-muted">/ @ViewBag.TotalBeds</span></h2>
            <small class="text-muted">@ViewBag.FreeBeds free right now</small>
        </div>
    </div>
    <div class="col-md-3">
        <div class="pro-card h-100 text-center border-start border-4 border-warning">
            <h6 class="text-muted text-uppercase mb-2">Active Admissions</h6>
            <h2 class="fw-bold text-warning mb-0">@ViewBag.ActiveAdmissions</h2>
            <small class="text-muted">Currently admitted</small>
        </div>
    </div>
    <div class="col-md-3">
        <div class="pro-card h-100 text-center border-start border-4 border-danger">
            <h6 class="text-muted text-uppercase mb-2">Outstanding Bills</h6>
            <h2 class="fw-bold text-danger mb-0">@ViewBag.UnpaidBillCount</h2>
            <small class="text-muted">৳@(((decimal)ViewBag.OutstandingAmount).ToString("N2")) unpaid</small>
        </div>
    </div>
</div>

<div class="row g-4 mb-5">
    <div class="col-md-3">
        <div class="pro-card h-100">
            <div class="icon-box mb-3 bg-success-subtle text-success">
                <i class="bi bi-person-plus-fill"></i>
            </div>
            <h5 class="mb-2">Register Patient</h5>
            <p class="text-muted mb-4 small">Register a new patient and optionally issue a portal login.</p>
            <a asp-controller="Patients" asp-action="Create" class="btn btn-outline-success w-100">Register</a>
        </div>
    </div>
    <div class="col-md-3">
        <div class="pro-card h-100">
            <div class="icon-box mb-3 bg-primary-subtle text-primary">
                <i class="bi bi-calendar2-plus-fill"></i>
            </div>
            <h5 class="mb-2">Book Appointment</h5>
            <p class="text-muted mb-4 small">Add a walk-in patient to any doctor's queue.</p>
            <a asp-controller="Appointments" asp-action="Create" class="btn btn-outline-primary w-100">Book</a>
        </div>
    </div>
    <div class="col-md-3">
        <div class="pro-card h-100">
            <div class="icon-box mb-3 bg-warning-subtle text-warning-emphasis">
                <i class="bi bi-hospital"></i>
            </div>
            <h5 class="mb-2">Admit Patient</h5>
            <p class="text-muted mb-4 small">Admit a patient and assign an available bed.</p>
            <a asp-controller="Admissions" asp-action="Create" class="btn btn-outline-warning w-100">Admit</a>
        </div>
    </div>
    <div class="col-md-3">
        <div class="pro-card h-100">
            <div class="icon-box mb-3 bg-danger-subtle text-danger">
                <i class="bi bi-receipt"></i>
            </div>
            <h5 class="mb-2">Billing</h5>
            <p class="text-muted mb-4 small">Generate bills and record patient payments.</p>
            <a asp-controller="Bills" asp-action="Index" class="btn btn-outline-danger w-100">View Bills</a>
        </div>
    </div>
</div>

<!-- REAL-TIME WARD BED OCCUPANCY MAP -->
<div class="pro-card mb-5">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 border-bottom pb-3 mb-3">
        <div class="d-flex align-items-center gap-2">
            <div class="icon-box bg-info bg-opacity-20 text-info mb-0" style="width: 42px; height: 42px; font-size: 1.3rem;">
                <i class="bi bi-hospital"></i>
            </div>
            <div>
                <h5 class="mb-0 fw-bold text-strong">Ward Bed Occupancy &amp; Length-of-Stay</h5>
                <small class="text-muted">Live telemetry across active beds, patient occupancy, and admission duration</small>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle font-mono-data">
                <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i>@ViewBag.OccupiedBeds Occupied
            </span>
            <span class="badge bg-secondary bg-opacity-10 text-muted border font-mono-data">
                @ViewBag.FreeBeds Available
            </span>
            <a asp-controller="Beds" asp-action="Index" class="btn btn-sm btn-outline-primary ms-2">
                All Beds &rarr;
            </a>
        </div>
    </div>

    @{
        var bedCards = ViewBag.BedGrid as List<HospitalManagementSystem.Controllers.ReceptionBedCardDto> ?? new List<HospitalManagementSystem.Controllers.ReceptionBedCardDto>();
    }

    @if (bedCards.Any())
    {
        <div class="row g-3">
            @foreach (var b in bedCards)
            {
                <div class="col-xl-3 col-lg-4 col-md-6">
                    <div class="p-3 rounded border h-100 @(b.IsOccupied ? "bg-surface-card border-primary-subtle" : "bg-surface-sunken opacity-75")">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <span class="font-mono-data fw-bold fs-7 text-strong">Bed @b.BedNumber</span>
                                <small class="text-muted d-block" style="font-size: 0.72rem;">@b.Ward &bull; @b.Category</small>
                            </div>
                            @if (b.IsOccupied)
                            {
                                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle font-mono-data" style="font-size: 0.6875rem;">
                                    Occupied
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle font-mono-data" style="font-size: 0.6875rem;">
                                    Available
                                </span>
                            }
                        </div>

                        @if (b.IsOccupied)
                        {
                            <div class="mt-2 pt-2 border-top">
                                <div class="fw-semibold text-strong text-truncate" style="font-size: 0.8125rem;">
                                    @b.PatientName
                                </div>
                                <div class="small text-muted font-mono-data" style="font-size: 0.7rem;">
                                    UHID: @b.Uhid
                                </div>

                                <!-- Length of Stay Progress Bar -->
                                <div class="mt-2">
                                    <div class="d-flex justify-content-between text-muted" style="font-size: 0.6875rem;">
                                        <span>Length of Stay</span>
                                        <span class="font-mono-data fw-bold text-strong">Day @b.LengthOfStayDays</span>
                                    </div>
                                    <div class="progress mt-1" style="height: 4px;">
                                        @{
                                            var losPct = Math.Min(100, b.LengthOfStayDays * 20);
                                            var barColor = b.LengthOfStayDays >= 5 ? "bg-warning" : "bg-primary";
                                        }
                                        <div class="progress-bar @barColor" role="progressbar" style="width: @losPct%" aria-valuenow="@b.LengthOfStayDays" aria-valuemin="1" aria-valuemax="7"></div>
                                    </div>
                                </div>

                                <div class="mt-2 text-end">
                                    <a asp-controller="Admissions" asp-action="Details" asp-route-id="@b.AdmissionId" class="text-primary text-decoration-none" style="font-size: 0.72rem;">
                                        View Admission &rarr;
                                    </a>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="mt-3 pt-2 text-center">
                                <a asp-controller="Admissions" asp-action="Create" class="btn btn-xs btn-outline-success py-1 px-2 w-100" style="font-size: 0.75rem;">
                                    <i class="bi bi-plus-circle me-1"></i>Assign Bed
                                </a>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="pro-card h-100">
            <h5 class="border-bottom pb-3 mb-3">Recently Registered</h5>
            @if (ViewBag.RecentPatients != null && ((IEnumerable<HospitalManagementSystem.Models.Patient>)ViewBag.RecentPatients).Any())
            {
                <ul class="list-group list-group-flush">
                    @foreach (var p in (IEnumerable<HospitalManagementSystem.Models.Patient>)ViewBag.RecentPatients)
                    {
                        <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                            <div>
                                <a asp-controller="Patients" asp-action="Details" asp-route-id="@p.Id" class="text-decoration-none fw-medium">
                                    @(string.IsNullOrEmpty(p.FullName) ? $"Baby of {p.EmergencyContactName}" : p.FullName)
                                </a>
                                <div class="small text-muted">@p.Uhid</div>
                            </div>
                            <span class="text-muted small">@p.CreatedAt.ToLocalTime().ToString("MMM dd, hh:mm tt")</span>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="text-muted mb-0">No patients registered yet.</p>
            }
        </div>
    </div>
    <div class="col-md-6">
        <div class="pro-card h-100">
            <h5 class="border-bottom pb-3 mb-3">Directory Shortcuts</h5>
            <div class="d-grid gap-2">
                <a asp-controller="Patients" asp-action="Index" class="btn btn-light border text-start">
                    <i class="bi bi-people-fill me-2"></i> Patient Directory
                </a>
                <a asp-controller="Admissions" asp-action="Index" class="btn btn-light border text-start">
                    <i class="bi bi-clipboard2-pulse-fill me-2"></i> Admissions Directory
                </a>
                <a asp-controller="Beds" asp-action="Index" class="btn btn-light border text-start">
                    <i class="bi bi-hospital me-2"></i> Bed Availability
                </a>
            </div>
        </div>
    </div>
</div>
