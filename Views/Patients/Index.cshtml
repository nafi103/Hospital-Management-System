@model IEnumerable<HospitalManagementSystem.Models.Patient>

@{
    ViewData["Title"] = "Patient Directory";
}

<div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
    <div>
        <h2 class="mb-1">Patient Directory</h2>
        <p class="text-muted mb-0">Manage all registered patients in the system.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-person-plus-fill me-1"></i> Register New Patient
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="pro-card mb-4 p-3">
    <form asp-action="Index" method="get" class="row g-3 align-items-center">
        <div class="col-md-10">
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input type="text" name="searchString" class="form-control border-start-0" placeholder="Search by Name, UHID, or Phone Number..." value="@Context.Request.Query["searchString"]">
            </div>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-outline-secondary w-100">Search</button>
        </div>
    </form>
</div>

<div class="pro-card p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">UHID</th>
                    <th>Patient Name</th>
                    <th>Contact</th>
                    <th>Blood Group</th>
                    <th>Registration Date</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-medium text-primary">@item.Uhid</td>
                            <td class="fw-medium">
                                @(string.IsNullOrEmpty(item.FullName) ? $"Baby of {item.EmergencyContactName}" : item.FullName)
                                @if(item.IsChild) { <span class="badge bg-info ms-1 px-2 py-1" style="font-size: 0.65rem;">Minor</span> }
                                <div class="small text-muted fw-normal">@item.Gender, @(DateTime.Now.Year - item.DateOfBirth.Year) yrs</div>
                            </td>
                            <td>+880@(item.ContactInfo ?? item.EmergencyContactPhone)</td>
                            <td>
                                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger-subtle">@item.BloodGroup</span>
                            </td>
                            <td>@item.CreatedAt.ToString("dd/MM/yy")</td>
                            <td class="text-end pe-4">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary me-1" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Profile">
                                    Profile
                                </a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this patient? This action cannot be undone.');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger ms-1" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-3"></i>
                            No patients found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
