@model HospitalManagementSystem.Models.Patient
@using HospitalManagementSystem.Models

@{
    ViewData["Title"] = "Patient Profile";
}

<div class="mb-4 border-bottom pb-3 d-flex justify-content-between align-items-center">
    <div>
        <a asp-action="Index" class="text-decoration-none text-muted mb-2 d-inline-block">
            <i class="bi bi-arrow-left"></i> Back to Directory
        </a>
        <h2 class="mb-1">Patient Profile</h2>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-outline-secondary">
            <i class="bi bi-pencil me-1"></i> Edit Profile
        </a>
        <form asp-action="Delete" asp-route-id="@Model?.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this patient?');">
            <button type="submit" class="btn btn-outline-danger">
                <i class="bi bi-trash me-1"></i> Delete
            </button>
        </form>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    <!-- Patient Demographics Card -->
    <div class="col-md-4 mb-4">
        <div class="pro-card text-center h-100">
            <div class="icon-box mx-auto mb-3" style="width: 80px; height: 80px; font-size: 2.5rem;">
                <i class="bi bi-person"></i>
            </div>
            <h4 class="mb-1">
                @(string.IsNullOrEmpty(Model.FullName) ? $"Baby of {Model.EmergencyContactName}" : Model.FullName)
                @if(Model.IsChild) { <span class="badge bg-info align-middle ms-2" style="font-size: 0.8rem;">Minor</span> }
            </h4>
            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle px-3 py-2 mb-4 fs-6">
                @Model.Uhid
            </span>
            
            <ul class="list-group list-group-flush text-start mt-3">
                <li class="list-group-item px-0 py-3 d-flex justify-content-between">
                    <span class="text-muted"><i class="bi bi-telephone me-2"></i>Contact</span>
                    <span class="fw-medium">+880@(Model.ContactInfo ?? Model.EmergencyContactPhone)</span>
                </li>
                <li class="list-group-item px-0 py-3 d-flex justify-content-between">
                    <span class="text-muted"><i class="bi bi-calendar me-2"></i>Date of Birth</span>
                    <span class="fw-medium">@Model.DateOfBirth.ToString("dd/MM/yy")</span>
                </li>
                <li class="list-group-item px-0 py-3 d-flex justify-content-between">
                    <span class="text-muted"><i class="bi bi-gender-ambiguous me-2"></i>Gender</span>
                    <span class="fw-medium">@Model.Gender</span>
                </li>
                <li class="list-group-item px-0 py-3 d-flex justify-content-between">
                    <span class="text-muted"><i class="bi bi-droplet me-2 text-danger"></i>Blood Group</span>
                    <span class="fw-medium text-danger">@(string.IsNullOrEmpty(Model.BloodGroup) ? "Unknown" : Model.BloodGroup)</span>
                </li>
            </ul>
        </div>
    </div>

    <!-- Additional Info / Timeline -->
    <div class="col-md-8 mb-4">
        <div class="pro-card h-100">
            <h4 class="border-bottom pb-3 mb-4">@(Model.IsChild ? "Guardian Information" : "Emergency Information")</h4>
            <div class="mb-5">
                <div class="row">
                    <div class="col-md-6">
                        <p class="text-muted mb-1">Name</p>
                        <p class="fs-5 fw-medium">@Model.EmergencyContactName</p>
                    </div>
                    <div class="col-md-6">
                        <p class="text-muted mb-1">Phone</p>
                        <p class="fs-5 fw-medium">+880@Model.EmergencyContactPhone</p>
                    </div>
                    @if (Model.RegisteredBy != null)
                    {
                        <div class="mt-3 pt-3 border-top">
                            <small class="text-muted"><i class="bi bi-pencil-square me-1"></i> Registered By: <strong>@Model.RegisteredBy.FullName</strong></small>
                        </div>
                    }
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
                <h4 class="mb-0"><i class="bi bi-exclamation-triangle text-danger me-2"></i>Allergies</h4>
                <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#addAllergyModal">
                    <i class="bi bi-plus-lg me-1"></i> Add Allergy
                </button>
            </div>
            @if (Model.Allergies != null && Model.Allergies.Any())
            {
                <div class="mb-5">
                    @foreach (var allergy in Model.Allergies.OrderByDescending(a => a.Severity))
                    {
                        var severityClass = allergy.Severity switch
                        {
                            AllergySeverity.LifeThreatening => "danger",
                            AllergySeverity.Severe => "danger",
                            AllergySeverity.Moderate => "warning",
                            _ => "secondary"
                        };
                        <div class="d-flex justify-content-between align-items-center p-3 mb-2 rounded-3 border border-@severityClass border-opacity-50 bg-@severityClass bg-opacity-10">
                            <div>
                                <span class="fw-bold">@allergy.Substance</span>
                                <span class="badge bg-@severityClass ms-2">@allergy.Severity</span>
                                @if (!string.IsNullOrWhiteSpace(allergy.ReactionType))
                                {
                                    <div class="text-muted small mt-1">Reaction: @allergy.ReactionType</div>
                                }
                            </div>
                            <form asp-controller="PatientAllergies" asp-action="Delete" asp-route-id="@allergy.Id" method="post" onsubmit="return confirm('Remove this allergy record?');">
                                <button type="submit" class="btn btn-sm btn-light text-danger" title="Remove"><i class="bi bi-trash"></i></button>
                            </form>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-4 text-muted bg-light rounded border border-dashed mb-5">
                    <i class="bi bi-shield-check fs-2 d-block mb-2"></i>
                    <p class="mb-0">No known allergies recorded.</p>
                </div>
            }

            <div id="ai-case-notes" class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
                <h4 class="mb-0"><i class="bi bi-robot text-info me-2"></i>AI Case Notes</h4>
                <button type="button" id="generateCaseSummaryBtn" class="btn btn-sm btn-outline-info" data-patient-id="@Model.Id" @(ViewBag.HasMedicalRecords == true ? "" : "disabled title=\"No medical records yet to summarize\"")>
                    <i class="bi bi-magic me-1"></i> Generate Case Summary
                </button>
            </div>

            <div id="caseSummaryStreamError" class="alert alert-danger d-none mb-3" role="alert"></div>
            <div id="caseSummaryStreamPlaceholder" class="text-muted small mb-3 d-none">
                <span class="spinner-border spinner-border-sm me-1"></span> Waiting for the model&hellip;
            </div>
            <p id="caseSummaryStreamFeed" class="pro-card border-start border-4 border-info mb-3 d-none"></p>

            @{
                var aiSuggestions = ViewBag.AiSuggestions as List<HospitalManagementSystem.Models.AiSuggestion>;
            }
            <div id="aiSuggestionsList" class="mb-5">
                @if (aiSuggestions != null && aiSuggestions.Any())
                {
                    foreach (var suggestion in aiSuggestions)
                    {
                        <partial name="_SuggestionCard" model="suggestion" />
                    }
                }
                else
                {
                    <div id="noAiSuggestionsEmptyState" class="text-center py-4 text-muted bg-light rounded border border-dashed">
                        <i class="bi bi-robot fs-2 d-block mb-2"></i>
                        <p class="mb-0">No AI drafts generated yet.</p>
                    </div>
                }
            </div>

            <h4 class="border-bottom pb-3 mb-4">Hospital History</h4>
            <div class="text-center py-5 text-muted bg-light rounded border border-dashed">
                <i class="bi bi-clock-history fs-2 d-block mb-2"></i>
                <p class="mb-0">Patient history tracking (Admissions, Appointments) will appear here.</p>
                <small>This module is pending implementation.</small>
            </div>

            <div class="mt-4 text-end">
                <p class="text-muted small mb-0">Registered on: @Model.CreatedAt.ToString("dd/MM/yy hh:mm tt")</p>
            </div>
        </div>
    </div>
</div>

<!-- Add Allergy Modal -->
<div class="modal fade" id="addAllergyModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="PatientAllergies" asp-action="Create" method="post">
                <input type="hidden" name="patientId" value="@Model.Id" />
                <div class="modal-header">
                    <h5 class="modal-title">Record New Allergy</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-medium">Substance <span class="text-danger">*</span></label>
                        <input type="text" name="substance" class="form-control" placeholder="e.g. Penicillin, Azithromycin, Peanuts" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-medium">Drug Class (if applicable)</label>
                        <select name="allergenGenericName" class="form-select">
                            <option value="">-- Not a formulary drug / other allergen --</option>
                            @if (ViewBag.KnownAllergens != null)
                            {
                                @foreach (var generic in (List<string>)ViewBag.KnownAllergens)
                                {
                                    <option value="@generic">@generic</option>
                                }
                            }
                        </select>
                        <small class="text-muted">Link to a formulary generic name so prescriptions are checked against it automatically.</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-medium">Reaction</label>
                        <input type="text" name="reactionType" class="form-control" placeholder="e.g. Rash, Anaphylaxis, Vomiting" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-medium">Severity <span class="text-danger">*</span></label>
                        <select name="severity" class="form-select" required>
                            <option value="@AllergySeverity.Mild">Mild</option>
                            <option value="@AllergySeverity.Moderate">Moderate</option>
                            <option value="@AllergySeverity.Severe">Severe</option>
                            <option value="@AllergySeverity.LifeThreatening">Life-Threatening</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Save Allergy</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.12/signalr.min.js"></script>
    <script src="~/js/ai-stream.js" asp-append-version="true"></script>
}
