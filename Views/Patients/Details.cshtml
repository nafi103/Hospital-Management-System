@model HospitalManagementSystem.Models.Patient

@{
    ViewData["Title"] = "Patient Profile";
}

<div class="mb-4 border-bottom pb-3 d-flex justify-content-between align-items-center">
    <div>
        <a asp-action="Index" class="text-decoration-none text-muted mb-2 d-inline-block">
            <i class="bi bi-arrow-left"></i> Back to Directory
        </a>
        <h2 class="mb-1">Patient Profile</h2>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-outline-secondary">
            <i class="bi bi-pencil me-1"></i> Edit Profile
        </a>
        <form asp-action="Delete" asp-route-id="@Model?.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this patient?');">
            <button type="submit" class="btn btn-outline-danger">
                <i class="bi bi-trash me-1"></i> Delete
            </button>
        </form>
    </div>
</div>

<div class="row">
    <!-- Patient Demographics Card -->
    <div class="col-md-4 mb-4">
        <div class="pro-card text-center h-100">
            <div class="icon-box mx-auto mb-3" style="width: 80px; height: 80px; font-size: 2.5rem;">
                <i class="bi bi-person"></i>
            </div>
            <h4 class="mb-1">
                @(string.IsNullOrEmpty(Model.FullName) ? $"Baby of {Model.EmergencyContactName}" : Model.FullName)
                @if(Model.IsChild) { <span class="badge bg-info align-middle ms-2" style="font-size: 0.8rem;">Minor</span> }
            </h4>
            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle px-3 py-2 mb-4 fs-6">
                @Model.Uhid
            </span>
            
            <ul class="list-group list-group-flush text-start mt-3">
                <li class="list-group-item px-0 py-3 d-flex justify-content-between">
                    <span class="text-muted"><i class="bi bi-telephone me-2"></i>Contact</span>
                    <span class="fw-medium">+880@(Model.ContactInfo ?? Model.EmergencyContactPhone)</span>
                </li>
                <li class="list-group-item px-0 py-3 d-flex justify-content-between">
                    <span class="text-muted"><i class="bi bi-calendar me-2"></i>Date of Birth</span>
                    <span class="fw-medium">@Model.DateOfBirth.ToString("dd/MM/yy")</span>
                </li>
                <li class="list-group-item px-0 py-3 d-flex justify-content-between">
                    <span class="text-muted"><i class="bi bi-gender-ambiguous me-2"></i>Gender</span>
                    <span class="fw-medium">@Model.Gender</span>
                </li>
                <li class="list-group-item px-0 py-3 d-flex justify-content-between">
                    <span class="text-muted"><i class="bi bi-droplet me-2 text-danger"></i>Blood Group</span>
                    <span class="fw-medium text-danger">@(string.IsNullOrEmpty(Model.BloodGroup) ? "Unknown" : Model.BloodGroup)</span>
                </li>
            </ul>
        </div>
    </div>

    <!-- Additional Info / Timeline -->
    <div class="col-md-8 mb-4">
        <div class="pro-card h-100">
            <h4 class="border-bottom pb-3 mb-4">@(Model.IsChild ? "Guardian Information" : "Emergency Information")</h4>
            <div class="mb-5">
                <div class="row">
                    <div class="col-md-6">
                        <p class="text-muted mb-1">Name</p>
                        <p class="fs-5 fw-medium">@Model.EmergencyContactName</p>
                    </div>
                    <div class="col-md-6">
                        <p class="text-muted mb-1">Phone</p>
                        <p class="fs-5 fw-medium">+880@Model.EmergencyContactPhone</p>
                    </div>
                    @if (Model.RegisteredBy != null)
                    {
                        <div class="mt-3 pt-3 border-top">
                            <small class="text-muted"><i class="bi bi-pencil-square me-1"></i> Registered By: <strong>@Model.RegisteredBy.FullName</strong></small>
                        </div>
                    }
                </div>
            </div>

            <h4 class="border-bottom pb-3 mb-4">Hospital History</h4>
            <div class="text-center py-5 text-muted bg-light rounded border border-dashed">
                <i class="bi bi-clock-history fs-2 d-block mb-2"></i>
                <p class="mb-0">Patient history tracking (Admissions, Appointments) will appear here.</p>
                <small>This module is pending implementation.</small>
            </div>
            
            <div class="mt-4 text-end">
                <p class="text-muted small mb-0">Registered on: @Model.CreatedAt.ToString("dd/MM/yy hh:mm tt")</p>
            </div>
        </div>
    </div>
</div>
