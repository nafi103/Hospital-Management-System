@model IEnumerable<HospitalManagementSystem.Models.Appointment>

@{
    ViewData["Title"] = "Consultations";
}

<div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
    <div>
        <h2 class="mb-1">Today's Consultations</h2>
        <p class="text-muted mb-0">Manage walk-in patients waiting for consultation.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-person-plus-fill me-1"></i> Add to Queue
    </a>
</div>

<div class="pro-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Wait Time</th>
                    <th>Patient</th>
                    <th>Doctor</th>
                    <th>Reason</th>
                    <th>Status</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model) {
                <tr id="appointment-row-@item.Id">
                    <td class="ps-4">
                        @{
                            var waitTime = DateTime.UtcNow - item.AppointmentDatetime;
                            var waitText = "";
                            if (waitTime.TotalMinutes < 0) waitText = "0 mins";
                            else if (waitTime.TotalMinutes < 1) waitText = "Just now";
                            else if (waitTime.TotalHours < 1) waitText = $"{(int)waitTime.TotalMinutes} mins";
                            else waitText = $"{(int)waitTime.TotalHours}h {waitTime.Minutes}m";
                        }
                        <div class="fw-medium text-danger">@waitText</div>
                        <small class="text-muted">Arrived: @item.AppointmentDatetime.ToLocalTime().ToString("hh:mm tt")</small>
                    </td>
                    <td>
                        <div class="fw-bold text-primary">@item.Patient?.FullName</div>
                        <small class="text-muted">@item.Patient?.Uhid</small>
                    </td>
                    <td>
                        <div class="fw-medium">@item.Doctor?.FullName</div>
                    </td>
                    <td>
                        <span class="text-truncate d-inline-block" style="max-width: 150px;" title="@item.ReasonForVisit">
                            @(string.IsNullOrEmpty(item.ReasonForVisit) ? "-" : item.ReasonForVisit)
                        </span>
                    </td>
                    <td>
                        @if(item.Status == HospitalManagementSystem.Models.AppointmentStatus.Scheduled) {
                            <span class="badge bg-warning bg-opacity-10 text-warning border border-warning-subtle">Waiting</span>
                        } else if(item.Status == HospitalManagementSystem.Models.AppointmentStatus.InConsultation) {
                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle">With Doctor</span>
                        } else if(item.Status == HospitalManagementSystem.Models.AppointmentStatus.Completed) {
                            <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle">Completed</span>
                        } else {
                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger-subtle">Cancelled</span>
                        }
                    </td>

                    <td class="text-end">
                        <div class="d-flex justify-content-end gap-1">
                            @if(item.Status == HospitalManagementSystem.Models.AppointmentStatus.Scheduled)
                            {
                                <form asp-action="SendIn" asp-route-id="@item.Id" method="post" style="display:inline;">
                                    <button type="submit" class="btn btn-sm btn-primary" title="Send In to Doctor">
                                        Send In <i class="bi bi-box-arrow-in-right ms-1"></i>
                                    </button>
                                </form>
                            }
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light text-primary" title="Edit">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-light text-danger" title="Cancel/Delete">
                                <i class="bi bi-trash"></i>
                            </a>
                        </div>
                    </td>
                </tr>
                }
                
                @if(!Model.Any()) {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">
                            <i class="bi bi-people fs-1 d-block mb-2 text-black-50"></i>
                            No patients currently in the queue.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
