@model HospitalManagementSystem.Models.Appointment
@using HospitalManagementSystem.Models

@{
    ViewData["Title"] = "Add to Consultations";
}

<div class="mb-4 border-bottom pb-3">
    <a asp-action="Index" class="text-decoration-none text-muted mb-2 d-inline-block">
        <i class="bi bi-arrow-left"></i> Back to Consultations
    </a>
    <h2 class="mb-1">Add to Consultations</h2>
    <p class="text-muted mb-0">Register a walk-in patient for a doctor's queue today.</p>
</div>

<div class="row">
    <div class="col-md-8 mx-auto">
        <div class="pro-card">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                
                <h5 class="card-title text-primary mb-4 border-bottom pb-2">Appointment Details</h5>
                
                <div class="row g-4 mb-4">
                    <div class="col-md-12">
                        <label class="form-label fw-medium">Find Patient <span class="text-danger">*</span></label>
                        
                        <div class="position-relative mb-2" id="SearchWrapper">
                            <div class="input-group" id="SearchGroup">
                                <span class="input-group-text bg-white text-muted"><i class="bi bi-search"></i></span>
                                <input type="text" id="PatientSearchInput" class="form-control" placeholder="Type UHID, Phone, or Name to search..." autocomplete="off">
                            </div>
                            
                            <!-- Search Results Dropdown -->
                            <div id="SearchResults" class="list-group position-absolute w-100 shadow-sm" style="display: none; z-index: 1000; max-height: 250px; overflow-y: auto; top: 100%; left: 0; margin-top: 4px;"></div>
                        </div>
                        
                        <div class="mt-2 text-end mb-3" id="RegisterNewPrompt">
                            <small class="text-muted">Patient not found? <a asp-controller="Patients" asp-action="Create" class="text-decoration-none fw-bold"><i class="bi bi-person-plus"></i> Register New Patient</a></small>
                        </div>

                        <!-- Selected Patient Card -->
                        <div id="SelectedPatientCard" class="card border-primary bg-primary bg-opacity-10 mb-2" style="display: none;">
                            <div class="card-body d-flex justify-content-between align-items-center py-2">
                                <div>
                                    <h6 class="mb-0 fw-bold text-primary" id="SP_Name"></h6>
                                    <small class="text-muted" id="SP_Uhid"></small>
                                </div>
                                <button type="button" class="btn btn-sm btn-light text-danger rounded-circle" id="ClearPatientBtn" title="Clear selection">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Hidden Input for Form Submission -->
                        <input type="hidden" asp-for="PatientId" id="PatientIdHidden" required />
                        <span asp-validation-for="PatientId" class="text-danger small"></span>
                    </div>

                    @if (User.IsInRole("Assistant"))
                    {
                        var selectList = ViewBag.DoctorId as SelectList;
                        var doctorName = selectList?.FirstOrDefault()?.Text;
                        var doctorId = selectList?.FirstOrDefault()?.Value;
                        
                        <div class="col-md-12">
                            <label class="form-label fw-medium">Assigned Doctor</label>
                            <input type="text" class="form-control bg-light text-muted" value="@doctorName" readonly tabindex="-1" style="cursor: not-allowed;" />
                            <input type="hidden" asp-for="DoctorId" value="@doctorId" />
                            <span asp-validation-for="DoctorId" class="text-danger small"></span>
                        </div>
                    }
                    else
                    {
                        <div class="col-md-12">
                            <label asp-for="DoctorId" class="form-label fw-medium">Select Doctor <span class="text-danger">*</span></label>
                            <select asp-for="DoctorId" class="form-select" asp-items="ViewBag.DoctorId" required>
                                <option value="">-- Choose a Doctor --</option>
                            </select>
                            <span asp-validation-for="DoctorId" class="text-danger small"></span>
                        </div>
                    }

                    <!-- Removed Start Time and End Time. Handled automatically in backend. -->
                    
                    @if (User.IsInRole("Assistant"))
                    {
                        <input type="hidden" asp-for="Status" value="0" />
                    }
                    else
                    {
                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label fw-medium">Status <span class="text-danger">*</span></label>
                            <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<AppointmentStatus>()"></select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>
                    }
                    <div class="col-md-12">
                        <label asp-for="ReasonForVisit" class="form-label fw-medium">Reason for Visit</label>
                        <textarea asp-for="ReasonForVisit" class="form-control" rows="3" placeholder="Brief description of symptoms or reason for visit..."></textarea>
                        <span asp-validation-for="ReasonForVisit" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Index" class="btn btn-light border">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4">Add to Queue</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function() {
            var searchTimeout;
            
            $('#PatientSearchInput').on('input', function() {
                clearTimeout(searchTimeout);
                var query = $(this).val().trim();
                
                if(query.length < 1) {
                    $('#SearchResults').hide();
                    return;
                }

                searchTimeout = setTimeout(function() {
                    performSearch(query);
                }, 300);
            });

            var currentFocus = -1;

            $('#PatientSearchInput').keydown(function(e) {
                var list = $('#SearchResults .list-group-item:not(.text-center)');
                if (e.which == 40) { // Down arrow
                    e.preventDefault();
                    currentFocus++;
                    addActive(list);
                } else if (e.which == 38) { // Up arrow
                    e.preventDefault();
                    currentFocus--;
                    addActive(list);
                } else if (e.which == 13) { // Enter
                    e.preventDefault();
                    if (currentFocus > -1) {
                        if (list) list[currentFocus].click();
                    } else {
                        var query = $(this).val().trim();
                        if(query.length >= 1) performSearch(query);
                    }
                }
            });

            function addActive(x) {
                if (!x || x.length === 0) return false;
                removeActive(x);
                if (currentFocus >= x.length) currentFocus = 0;
                if (currentFocus < 0) currentFocus = (x.length - 1);
                $(x[currentFocus]).addClass('search-item-active').removeClass('text-muted');
                x[currentFocus].scrollIntoView({ block: 'nearest' });
            }

            function removeActive(x) {
                for (var i = 0; i < x.length; i++) {
                    $(x[i]).removeClass('search-item-active');
                }
            }

            function performSearch(query) {
                $.ajax({
                    url: '@Url.Action("Search", "Patients")',
                    data: { q: query },
                    success: function(data) {
                        $('#SearchResults').empty().show();
                        currentFocus = -1;
                        if(data.results.length === 0) {
                            $('#SearchResults').append('<div class="list-group-item text-muted text-center py-3">No patients found matching "'+query+'"</div>');
                        } else {
                            data.results.forEach(function(p) {
                                var parts = p.text.split(" - ");
                                var uhid = parts[0];
                                var name = parts[1];

                                var item = $('<a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"></a>')
                                    .html('<div><span class="fw-bold">' + name + '</span><br><small class="text-muted">' + uhid + '</small></div> <i class="bi bi-chevron-right text-muted"></i>')
                                    .click(function(e) {
                                        e.preventDefault();
                                        selectPatient(p.id, uhid, name);
                                    });
                                $('#SearchResults').append(item);
                            });
                        }
                    }
                });
            }

            $(document).click(function(e) {
                if (!$(e.target).closest('#SearchWrapper').length) {
                    $('#SearchResults').hide();
                }
            });

            function selectPatient(id, uhid, name) {
                $('#PatientIdHidden').val(id);
                $('#SP_Uhid').text(uhid);
                $('#SP_Name').text(name);
                
                $('#SearchResults').hide();
                $('#SearchWrapper').hide();
                $('#SelectedPatientCard').fadeIn();
            }

            $('#ClearPatientBtn').click(function() {
                $('#PatientIdHidden').val('');
                $('#SelectedPatientCard').hide();
                $('#SearchWrapper').fadeIn();
                $('#PatientSearchInput').val('').focus();
            });
        });
    </script>
}
