@model HospitalManagementSystem.Models.ViewModels.ReportsViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Reports";

    var jsonOptions = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };

    var departmentLabels = Model.RevenueByDepartment.Select(d => d.Department.ToString()).ToList();
    var departmentAmounts = Model.RevenueByDepartment.Select(d => d.Amount).ToList();

    var occupancyLabels = Model.BedOccupancy.Select(o => o.Category.ToString()).ToList();
    var occupancyFree = Model.BedOccupancy.Select(o => o.Total - o.Occupied).ToList();
    var occupancyOccupied = Model.BedOccupancy.Select(o => o.Occupied).ToList();

    var appointmentLabels = Model.AppointmentVolume.Select(p => p.Date.ToString("MMM dd")).ToList();
    var appointmentTotals = Model.AppointmentVolume.Select(p => p.Total).ToList();

    var triageLabels = Model.TriageMix.Select(t => t.Priority.ToString()).ToList();
    var triageCounts = Model.TriageMix.Select(t => t.Count).ToList();

    var aiLabels = Model.AiVerdicts.Select(a => a.Verdict.ToString()).ToList();
    var aiCounts = Model.AiVerdicts.Select(a => a.Count).ToList();

    var safetyLabels = Model.SafetyWarningsByCategory.Select(s => s.Category).ToList();
    var safetyCounts = Model.SafetyWarningsByCategory.Select(s => s.Count).ToList();
}

<div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-4 border-bottom pb-3">
    <div>
        <h2 class="mb-1">Reports</h2>
        <p class="text-muted mb-0">Revenue, occupancy, appointment volume, triage mix, and AI governance.</p>
    </div>
    <form method="get" class="d-flex align-items-end gap-2">
        <div>
            <label class="form-label small text-muted mb-1">From</label>
            <input type="date" name="from" class="form-control form-control-sm" value="@Model.FromDate.ToString("yyyy-MM-dd")" />
        </div>
        <div>
            <label class="form-label small text-muted mb-1">To</label>
            <input type="date" name="to" class="form-control form-control-sm" value="@Model.ToDate.ToString("yyyy-MM-dd")" />
        </div>
        <button type="submit" class="btn btn-sm btn-primary">Apply</button>
        <a asp-action="ExportAppointmentsCsv" asp-route-from="@Model.FromDate.ToString("yyyy-MM-dd")" asp-route-to="@Model.ToDate.ToString("yyyy-MM-dd")" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-download me-1"></i> Export CSV
        </a>
        <button type="submit" class="btn btn-sm btn-outline-success" formaction="@Url.Action("VerifyLedger")" formmethod="post" title="Recompute cryptographic SHA-256 hash chain and audit all ledger rows for database tampering">
            <i class="bi bi-shield-check me-1"></i> Verify Ledger Integrity
        </button>
    </form>
</div>

<p class="text-muted small mb-4">
    Revenue and appointment volume reflect <strong>@Model.FromDate.ToString("MMM dd, yyyy")</strong> to
    <strong>@Model.ToDate.ToString("MMM dd, yyyy")</strong>. Occupancy, triage, AI governance, and top
    medicines are current-state snapshots across all data.
</p>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="pro-card h-100 text-center border-start border-4 border-primary">
            <h6 class="text-muted text-uppercase mb-2">Total Billed</h6>
            <h2 class="fw-bold text-primary mb-0">৳@Model.TotalBilled.ToString("N2")</h2>
        </div>
    </div>
    <div class="col-md-4">
        <div class="pro-card h-100 text-center border-start border-4 border-success">
            <h6 class="text-muted text-uppercase mb-2">Total Collected</h6>
            <h2 class="fw-bold text-success mb-0">৳@Model.TotalCollected.ToString("N2")</h2>
        </div>
    </div>
    <div class="col-md-4">
        <div class="pro-card h-100 text-center border-start border-4 border-danger">
            <h6 class="text-muted text-uppercase mb-2">Outstanding</h6>
            <h2 class="fw-bold text-danger mb-0">৳@Model.TotalOutstanding.ToString("N2")</h2>
        </div>
    </div>
</div>

@{
    var recentBlocks = ViewBag.RecentLedgerBlocks as List<HospitalManagementSystem.Models.PaymentTransaction> ?? new List<HospitalManagementSystem.Models.PaymentTransaction>();
}

<!-- CRYPTOGRAPHIC FINANCIAL LEDGER BLOCKCHAIN -->
<div class="pro-card mb-4 border-2" style="border-color: rgba(16, 185, 129, 0.35) !important;">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 border-bottom pb-3 mb-3">
        <div class="d-flex align-items-center gap-2">
            <div class="icon-box bg-success bg-opacity-20 text-success mb-0" style="width: 42px; height: 42px; font-size: 1.3rem;">
                <i class="bi bi-link-45deg"></i>
            </div>
            <div>
                <h5 class="mb-0 fw-bold text-strong">Cryptographic Ledger Chain (SHA-256)</h5>
                <small class="text-muted">Tamper-evident hash chain securing all transaction entries against manual database edits</small>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span id="ledgerAuditStatusBadge" class="badge bg-success bg-opacity-10 text-success border border-success-subtle font-mono-data px-2 py-1">
                <i class="bi bi-shield-check me-1"></i>Chain Verified
            </span>
            <button type="button" id="btnLiveVerifyLedger" class="btn btn-sm btn-outline-success font-sans">
                <i class="bi bi-arrow-repeat me-1"></i> Verify Ledger Integrity
            </button>
        </div>
    </div>

    @if (recentBlocks.Any())
    {
        <div class="d-flex align-items-center gap-2 overflow-auto py-2">
            @for (int b = recentBlocks.Count - 1; b >= 0; b--)
            {
                var blk = recentBlocks[b];
                var shortPrev = !string.IsNullOrEmpty(blk.PreviousHash) && blk.PreviousHash.Length >= 8 ? blk.PreviousHash[..8] : "GENESIS";
                var shortHash = !string.IsNullOrEmpty(blk.RowHash) && blk.RowHash.Length >= 8 ? blk.RowHash[..8] : "UNHASHED";

                <div class="ledger-block-card p-3 rounded bg-surface-sunken border font-mono-data flex-shrink-0 transition-all" id="ledger-block-@blk.Id" style="min-width: 220px; font-size: 0.75rem;">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="badge bg-primary bg-opacity-10 text-primary fw-bold">BLOCK #@blk.Id</span>
                        <span class="text-success fw-bold font-mono-data">৳@blk.Amount.ToString("N0")</span>
                    </div>
                    <div class="text-muted" style="font-size: 0.7rem;">Prev: <span class="text-secondary">@shortPrev...</span></div>
                    <div class="text-muted" style="font-size: 0.7rem;">Hash: <span class="text-primary fw-bold">@shortHash...</span></div>
                    <div class="text-muted mt-1" style="font-size: 0.6875rem;">@blk.PaymentMethod &bull; @blk.TransactionDate.ToLocalTime().ToString("MMM dd HH:mm")</div>
                </div>

                @if (b > 0)
                {
                    <div class="text-muted fs-5 px-1 blockchain-arrow">&rarr;</div>
                }
            }
        </div>
    }
    else
    {
        <div class="text-center py-3 text-muted small">
            No transactions in the cryptographic ledger yet. Transactions booked via Cash, Card, or bKash appear here as immutable blocks.
        </div>
    }
</div>

<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="pro-card h-100">
            <h5 class="border-bottom pb-3 mb-3">Revenue by Department</h5>
            @if (Model.RevenueByDepartment.Any())
            {
                <canvas id="departmentChart" height="220"></canvas>
            }
            else
            {
                <p class="text-muted mb-0">No billed items in this date range.</p>
            }
        </div>
    </div>
    <div class="col-md-6">
        <div class="pro-card h-100">
            <h5 class="border-bottom pb-3 mb-3">Bed Occupancy by Category</h5>
            @if (Model.BedOccupancy.Any())
            {
                <canvas id="occupancyChart" height="220"></canvas>
            }
            else
            {
                <p class="text-muted mb-0">No beds configured.</p>
            }
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-12">
        <div class="pro-card h-100">
            <h5 class="border-bottom pb-3 mb-3">Appointment Volume</h5>
            @if (Model.AppointmentVolume.Any(p => p.Total > 0))
            {
                <canvas id="appointmentChart" height="90"></canvas>
            }
            else
            {
                <p class="text-muted mb-0">No appointments in this date range.</p>
            }
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="pro-card h-100">
            <h5 class="border-bottom pb-3 mb-3">Triage Mix</h5>
            @if (Model.TriageMix.Any())
            {
                <canvas id="triageChart" height="220"></canvas>
            }
            else
            {
                <p class="text-muted mb-0">No vitals recorded yet.</p>
            }
        </div>
    </div>
    <div class="col-md-6">
        <div class="pro-card h-100">
            <h5 class="border-bottom pb-3 mb-3">AI Governance</h5>
            @if (Model.AiVerdicts.Any())
            {
                <canvas id="aiChart" height="180"></canvas>
                <div class="row text-center mt-3 pt-3 border-top">
                    <div class="col-4">
                        <div class="small text-muted">Input Tokens</div>
                        <div class="fw-bold">@Model.AiTotalInputTokens.ToString("N0")</div>
                    </div>
                    <div class="col-4">
                        <div class="small text-muted">Output Tokens</div>
                        <div class="fw-bold">@Model.AiTotalOutputTokens.ToString("N0")</div>
                    </div>
                    <div class="col-4">
                        <div class="small text-muted">Avg Latency</div>
                        <div class="fw-bold">@Model.AiAverageLatencyMs.ToString("N0") ms</div>
                    </div>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">No AI suggestions generated yet.</p>
            }
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-12">
        <div class="pro-card h-100">
            <h5 class="border-bottom pb-3 mb-3">Top 5 Prescribed Medicines</h5>
            @if (Model.TopMedicines.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Medicine</th>
                                <th class="text-end pe-4">Total Quantity Prescribed</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var med in Model.TopMedicines)
                            {
                                <tr>
                                    <td class="ps-2">@med.Name</td>
                                    <td class="text-end pe-4 fw-medium">@med.TotalQuantity</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">No prescriptions recorded yet.</p>
            }
        </div>
    </div>
</div>

<div class="row g-4 mt-0">
    <div class="col-12">
        <div class="pro-card h-100">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 border-bottom pb-3 mb-3">
                <h5 class="mb-0">Prescription Safety Net</h5>
                <span class="badge bg-success-subtle text-success border border-success-subtle">
                    <i class="bi bi-shield-check me-1"></i> All 4 checks deterministic &mdash; 0 AI calls
                </span>
            </div>
            <div class="row g-4 mb-4">
                <div class="col-md-4">
                    <div class="text-center border-end">
                        <h6 class="text-muted text-uppercase small mb-2">Prescriptions Checked</h6>
                        <h2 class="fw-bold text-primary mb-0">@Model.TotalPrescriptions.ToString("N0")</h2>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="text-center border-end">
                        <h6 class="text-muted text-uppercase small mb-2">Warnings Overridden</h6>
                        <h2 class="fw-bold text-warning mb-0">@Model.PrescriptionsWithSafetyOverride.ToString("N0")</h2>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="text-center">
                        <h6 class="text-muted text-uppercase small mb-2">Warning-Free</h6>
                        <h2 class="fw-bold text-success mb-0">@((Model.TotalPrescriptions - Model.PrescriptionsWithSafetyOverride).ToString("N0"))</h2>
                    </div>
                </div>
            </div>
            @if (Model.SafetyWarningsByCategory.Any())
            {
                <canvas id="safetyChart" height="90"></canvas>
            }
            else
            {
                <p class="text-muted mb-0">No safety warnings have been raised yet.</p>
            }
        </div>
    </div>
</div>

<div class="row g-4 mt-0">
    <div class="col-12">
        <div class="pro-card h-100">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 border-bottom pb-3 mb-3">
                <div>
                    <h5 class="mb-1"><i class="bi bi-boxes me-2 text-primary"></i>FEFO Pharmacy Batch Inventory &amp; Expiry Monitor</h5>
                    <small class="text-muted">First-Expired, First-Out (FEFO) automated batch allocation &middot; 30-day early expiration alert</small>
                </div>
                <div>
                    @if (Model.ExpiredBatchCount > 0)
                    {
                        <span class="badge bg-danger fs-6 py-2 px-3 me-2">
                            <i class="bi bi-slash-circle me-1"></i>@Model.ExpiredBatchCount Expired Batches Blocked
                        </span>
                    }
                    @if (Model.NearExpiryBatches.Any())
                    {
                        <span class="badge bg-warning text-dark fs-6 py-2 px-3">
                            <i class="bi bi-clock-history me-1"></i>@Model.NearExpiryBatches.Count Batches Within 30 Days
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle fs-6 py-2 px-3">
                            <i class="bi bi-check2-circle me-1"></i>All Batches Valid (>30 Days Shelf Life)
                        </span>
                    }
                </div>
            </div>

            @if (Model.NearExpiryBatches.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Medicine</th>
                                <th>Batch Number</th>
                                <th>Expiry Date</th>
                                <th class="text-center">Days Remaining</th>
                                <th class="text-end">Units in Batch</th>
                                <th class="text-center">Dispensing Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var batch in Model.NearExpiryBatches)
                            {
                                var isExpired = batch.DaysUntilExpiry <= 0;
                                <tr>
                                    <td class="fw-bold">@batch.MedicineName</td>
                                    <td><code>@batch.BatchNumber</code></td>
                                    <td>@batch.ExpiryDate.ToString("MMM dd, yyyy")</td>
                                    <td class="text-center">
                                        @if (isExpired)
                                        {
                                            <span class="badge bg-danger">EXPIRED</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">@batch.DaysUntilExpiry days</span>
                                        }
                                    </td>
                                    <td class="text-end fw-semibold">@batch.QuantityRemaining</td>
                                    <td class="text-center">
                                        @if (isExpired)
                                        {
                                            <span class="text-danger small fw-bold"><i class="bi bi-lock-fill me-1"></i>Blocked by FEFO</span>
                                        }
                                        else
                                        {
                                            <span class="text-warning small fw-bold"><i class="bi bi-hourglass-split me-1"></i>Earliest Allocation</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">No batches are near expiration or expired. All pharmacy stock is safe and active.</p>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script>
        (function () {
            const isDark = document.documentElement.getAttribute('data-bs-theme') === 'dark'
                || window.matchMedia('(prefers-color-scheme: dark)').matches;
            const gridColor = isDark ? 'rgba(255,255,255,0.1)' : 'rgba(0,0,0,0.06)';
            const textColor = isDark ? '#adb5bd' : '#495057';
            Chart.defaults.color = textColor;
            Chart.defaults.borderColor = gridColor;

            const palette = ['#4e73df', '#1cc88a', '#f6c23e', '#e74a3b', '#36b9cc', '#858796'];

            const departmentLabels = @Html.Raw(JsonSerializer.Serialize(departmentLabels, jsonOptions));
            const departmentAmounts = @Html.Raw(JsonSerializer.Serialize(departmentAmounts, jsonOptions));
            if (departmentLabels.length) {
                new Chart(document.getElementById('departmentChart'), {
                    type: 'doughnut',
                    data: { labels: departmentLabels, datasets: [{ data: departmentAmounts, backgroundColor: palette }] },
                    options: { responsive: true, plugins: { legend: { position: 'bottom' } } }
                });
            }

            const occupancyLabels = @Html.Raw(JsonSerializer.Serialize(occupancyLabels, jsonOptions));
            const occupancyFree = @Html.Raw(JsonSerializer.Serialize(occupancyFree, jsonOptions));
            const occupancyOccupied = @Html.Raw(JsonSerializer.Serialize(occupancyOccupied, jsonOptions));
            if (occupancyLabels.length) {
                new Chart(document.getElementById('occupancyChart'), {
                    type: 'bar',
                    data: {
                        labels: occupancyLabels,
                        datasets: [
                            { label: 'Occupied', data: occupancyOccupied, backgroundColor: '#e74a3b' },
                            { label: 'Free', data: occupancyFree, backgroundColor: '#1cc88a' }
                        ]
                    },
                    options: {
                        responsive: true,
                        scales: { x: { stacked: true }, y: { stacked: true, beginAtZero: true, ticks: { precision: 0 } } }
                    }
                });
            }

            const appointmentLabels = @Html.Raw(JsonSerializer.Serialize(appointmentLabels, jsonOptions));
            const appointmentTotals = @Html.Raw(JsonSerializer.Serialize(appointmentTotals, jsonOptions));
            if (appointmentLabels.length) {
                new Chart(document.getElementById('appointmentChart'), {
                    type: 'line',
                    data: {
                        labels: appointmentLabels,
                        datasets: [{
                            label: 'Appointments',
                            data: appointmentTotals,
                            borderColor: '#4e73df',
                            backgroundColor: 'rgba(78,115,223,0.15)',
                            fill: true,
                            tension: 0.3
                        }]
                    },
                    options: { responsive: true, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } }
                });
            }

            const triageLabels = @Html.Raw(JsonSerializer.Serialize(triageLabels, jsonOptions));
            const triageCounts = @Html.Raw(JsonSerializer.Serialize(triageCounts, jsonOptions));
            if (triageLabels.length) {
                const triageColors = { Normal: '#1cc88a', Urgent: '#f6c23e', Emergency: '#e74a3b' };
                new Chart(document.getElementById('triageChart'), {
                    type: 'bar',
                    data: {
                        labels: triageLabels,
                        datasets: [{ data: triageCounts, backgroundColor: triageLabels.map(l => triageColors[l] || '#858796') }]
                    },
                    options: { responsive: true, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } }
                });
            }

            const aiLabels = @Html.Raw(JsonSerializer.Serialize(aiLabels, jsonOptions));
            const aiCounts = @Html.Raw(JsonSerializer.Serialize(aiCounts, jsonOptions));
            if (aiLabels.length) {
                const verdictColors = { Pending: '#f6c23e', Accepted: '#1cc88a', Edited: '#36b9cc', Rejected: '#e74a3b' };
                new Chart(document.getElementById('aiChart'), {
                    type: 'bar',
                    data: {
                        labels: aiLabels,
                        datasets: [{ data: aiCounts, backgroundColor: aiLabels.map(l => verdictColors[l] || '#858796') }]
                    },
                    options: { responsive: true, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } }
                });
            }

            const safetyLabels = @Html.Raw(JsonSerializer.Serialize(safetyLabels, jsonOptions));
            const safetyCounts = @Html.Raw(JsonSerializer.Serialize(safetyCounts, jsonOptions));
            if (safetyLabels.length) {
                const safetyColors = { 'Allergy Conflict': '#e74a3b', 'Duplicate Therapy': '#f6c23e', 'Insufficient Stock': '#36b9cc', 'Pediatric Dose': '#4e73df' };
                new Chart(document.getElementById('safetyChart'), {
                    type: 'bar',
                    data: {
                        labels: safetyLabels,
                        datasets: [{ data: safetyCounts, backgroundColor: safetyLabels.map(l => safetyColors[l] || '#858796') }]
                    },
                    options: {
                        indexAxis: 'y',
                        responsive: true,
                        plugins: { legend: { display: false } },
                        scales: { x: { beginAtZero: true, ticks: { precision: 0 } } }
                    }
                });
            }

            // Live Ledger Verification Sweep
            const btnVerify = document.getElementById('btnLiveVerifyLedger');
            if (btnVerify) {
                btnVerify.addEventListener('click', function () {
                    const btn = this;
                    btn.disabled = true;
                    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Auditing Chain...';
                    
                    document.querySelectorAll('.ledger-block-card').forEach(function(el) {
                        el.style.borderColor = 'var(--status-warn-border)';
                    });

                    fetch('/Reports/LedgerStatus')
                        .then(r => r.json())
                        .then(data => {
                            if (data && data.isValid) {
                                document.querySelectorAll('.ledger-block-card').forEach(function(el, i) {
                                    setTimeout(function() {
                                        el.style.borderColor = '#10b981';
                                        el.style.backgroundColor = 'rgba(16, 185, 129, 0.1)';
                                    }, i * 150);
                                });
                                const badge = document.getElementById('ledgerAuditStatusBadge');
                                if (badge) {
                                    badge.className = 'badge bg-success text-white font-mono-data px-2 py-1';
                                    badge.innerHTML = '<i class="bi bi-shield-fill-check me-1"></i>All ' + data.verifiedTransactions + ' Blocks Valid';
                                }
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Cryptographic Ledger Verified',
                                    text: 'SHA-256 chain is intact across all ' + data.verifiedTransactions + ' financial transactions. Zero database tampering detected.',
                                    timer: 2500,
                                    showConfirmButton: false
                                });
                            } else {
                                document.querySelectorAll('.ledger-block-card').forEach(function(el) {
                                    el.style.borderColor = '#ef4444';
                                    el.style.backgroundColor = 'rgba(239, 68, 68, 0.1)';
                                });
                                const badge = document.getElementById('ledgerAuditStatusBadge');
                                if (badge) {
                                    badge.className = 'badge bg-danger text-white font-mono-data px-2 py-1';
                                    badge.innerHTML = '<i class="bi bi-shield-fill-x me-1"></i>Tamper Flagged';
                                }
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Ledger Audit Failure',
                                    text: data ? data.failureReason : 'Tamper detected in payment ledger.'
                                });
                            }
                        })
                        .catch(err => {
                            Swal.fire({
                                icon: 'error',
                                title: 'Verification Error',
                                text: 'Failed to complete ledger verification.'
                            });
                        })
                        .finally(() => {
                            btn.disabled = false;
                            btn.innerHTML = '<i class="bi bi-arrow-repeat me-1"></i> Verify Ledger Integrity';
                        });
                });
            }
        })();
    </script>
}
