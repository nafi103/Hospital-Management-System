@model HospitalManagementSystem.Models.Admission

@{
    ViewData["Title"] = "Delete Admission";
}

<div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
    <div>
        <h2 class="mb-1 text-danger">Delete Admission</h2>
        <p class="text-muted mb-0">Are you sure you want to delete this admission record?</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Back to Admissions
    </a>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="pro-card border-danger border-opacity-25">
            <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                <div>
                    <strong>Warning:</strong> This action cannot be undone. All associated bed transfers and records will also be deleted.
                </div>
            </div>

            <dl class="row mb-0">
                <dt class="col-sm-4 text-muted">Patient Name</dt>
                <dd class="col-sm-8 fw-medium">@(string.IsNullOrEmpty(Model.Patient?.FullName) ? $"Baby of {Model.Patient?.EmergencyContactName}" : Model.Patient?.FullName)</dd>

                <dt class="col-sm-4 text-muted">UHID</dt>
                <dd class="col-sm-8">@Model.Patient?.Uhid</dd>

                <dt class="col-sm-4 text-muted">Admitting Doctor</dt>
                <dd class="col-sm-8">@Model.AdmittingDoctor?.FullName</dd>

                <dt class="col-sm-4 text-muted">Admission Date</dt>
                <dd class="col-sm-8">@Model.AdmissionDate.ToString("MMM dd, yyyy hh:mm tt")</dd>

                @if (Model.DischargeDate.HasValue)
                {
                    <dt class="col-sm-4 text-muted">Discharge Date</dt>
                    <dd class="col-sm-8">@Model.DischargeDate.Value.ToString("MMM dd, yyyy hh:mm tt")</dd>
                }
            </dl>

            <div class="mt-4 pt-3 border-top">
                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light">Cancel</a>
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="bi bi-trash me-1"></i> Delete Admission
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
