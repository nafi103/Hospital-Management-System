@model HospitalManagementSystem.Models.AiSuggestion
@using HospitalManagementSystem.Models
@using HospitalManagementSystem.Services

@{
    var citedNarrative = AiNarrativeRenderer.RenderCitedNarrative(Model);
    var returnUrl = ViewData["ReturnUrl"] as string;
}

@if (citedNarrative != null)
{
    @citedNarrative
}
else
{
    <pre class="bg-light p-2 rounded small mb-2">@Model.PayloadJson</pre>
}

@if (Model.Verdict == AiSuggestionVerdict.Pending)
{
    <div class="d-flex gap-2 mt-2">
        <form asp-controller="AiReview" asp-action="Accept" asp-route-id="@Model.Id" method="post">
            @if (returnUrl != null) { <input type="hidden" name="returnUrl" value="@returnUrl" /> }
            <button type="submit" class="btn btn-sm btn-success"><i class="bi bi-check-lg"></i> Accept</button>
        </form>
        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#editSuggestion-@Model.Id">
            <i class="bi bi-pencil"></i> Edit
        </button>
        <form asp-controller="AiReview" asp-action="Reject" asp-route-id="@Model.Id" method="post">
            @if (returnUrl != null) { <input type="hidden" name="returnUrl" value="@returnUrl" /> }
            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-x-lg"></i> Reject</button>
        </form>
    </div>

    <div class="modal fade" id="editSuggestion-@Model.Id" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-controller="AiReview" asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    @if (returnUrl != null) { <input type="hidden" name="returnUrl" value="@returnUrl" /> }
                    <div class="modal-header">
                        <h5 class="modal-title">Edit AI Draft</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <textarea name="editedPayloadJson" class="form-control font-monospace" rows="8">@Model.PayloadJson</textarea>
                        <small class="text-muted">Raw draft JSON for now &mdash; a proper structured editor comes with the full feature later.</small>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save Edit</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
else
{
    var verdictClass = Model.Verdict switch
    {
        AiSuggestionVerdict.Accepted => "success",
        AiSuggestionVerdict.Rejected => "danger",
        _ => "primary"
    };
    <div class="d-flex align-items-center gap-2 mt-2">
        <span class="badge bg-@verdictClass">@Model.Verdict</span>
        <small class="text-muted">by @Model.ReviewedBy?.FullName on @(Model.ReviewedAt.HasValue ? Model.ReviewedAt.Value.ToLocalTime().ToString("MMM dd, hh:mm tt") : "-")</small>
    </div>
}
