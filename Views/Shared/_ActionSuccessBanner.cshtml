@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show d-flex justify-content-between align-items-center flex-wrap gap-2" role="alert">
        <span><i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]</span>
        @if (TempData.Peek("CrossLinkController") != null && TempData.Peek("CrossLinkPatientId") != null && TempData.Peek("CrossLinkDoctorId") != null)
        {
            <a class="btn btn-sm btn-success" asp-controller="@TempData.Peek("CrossLinkController")" asp-action="Create"
               asp-route-patientId="@TempData.Peek("CrossLinkPatientId")" asp-route-doctorId="@TempData.Peek("CrossLinkDoctorId")">
                @TempData.Peek("CrossLinkLabel") <i class="bi bi-arrow-right ms-1"></i>
            </a>
        }
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
