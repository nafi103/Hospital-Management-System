<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HMS</title>

    <script>
        // Resolves the theme before first paint so there's no light->dark flash.
        // Precedence: an explicit manual choice in localStorage, else "auto" -
        // dark if the OS says dark, or (OS has no preference either way) if it's
        // currently night (7pm-6am) locally.
        (function () {
            var stored = localStorage.getItem('hms-theme');
            var theme;
            if (stored === 'light' || stored === 'dark') {
                theme = stored;
            } else {
                var hour = new Date().getHours();
                var isNight = hour >= 19 || hour < 6;
                var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
                theme = (prefersDark || isNight) ? 'dark' : 'light';
            }
            document.documentElement.setAttribute('data-bs-theme', theme);
        })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Noto+Sans+Bengali:wght@400;500;600;700&display=swap">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.css">
    <!-- Select2 for AJAX searchable dropdowns -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.10.1/dist/sweetalert2.min.css" rel="stylesheet">

    <!-- site.css loads last so its theme tokens win over the widget stylesheets above -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var isPatient = User.IsInRole("Patient");
    var isFluid = ViewBag.FluidLayout == true;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}
<body>
@if (isAuthenticated)
{
    <div class="staff-app-container">
        <!-- Mobile Sidebar Backdrop -->
        <div id="sidebarBackdrop" class="sidebar-backdrop"></div>

        <!-- Fixed Sidebar (240px) -->
        <aside class="staff-sidebar">
            <div class="staff-sidebar-brand">
                <a class="brand-logo text-decoration-none" asp-area="" asp-controller="@(isPatient ? "Portal" : "Home")" asp-action="Index">
                    <i class="bi bi-hospital"></i>
                    <span>Nexus HMS</span>
                </a>
                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle text-uppercase font-mono-data" style="font-size: 0.65rem; padding: 0.2rem 0.45rem;">
                    @User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value
                </span>
            </div>

            <nav class="staff-sidebar-nav">
                @if (User.IsInRole("Doctor"))
                {
                    <div class="nav-section-title">Clinical Care</div>
                    <a class="sidebar-nav-link @(currentController == "DoctorDashboard" && currentAction == "Index" ? "active" : "")" asp-controller="DoctorDashboard" asp-action="Index">
                        <i class="bi bi-activity"></i>
                        <span>Consultations</span>
                    </a>
                    <a class="sidebar-nav-link @(currentController == "DoctorDashboard" && currentAction == "MyAssistant" ? "active" : "")" asp-controller="DoctorDashboard" asp-action="MyAssistant">
                        <i class="bi bi-person-badge"></i>
                        <span>My Assistant</span>
                    </a>
                    <a class="sidebar-nav-link @(currentController == "Prescriptions" ? "active" : "")" asp-controller="Prescriptions" asp-action="Index">
                        <i class="bi bi-file-earmark-medical"></i>
                        <span>Prescriptions</span>
                    </a>
                    <a class="sidebar-nav-link @(currentController == "MedicalRecords" ? "active" : "")" asp-controller="MedicalRecords" asp-action="Index">
                        <i class="bi bi-clipboard2-pulse"></i>
                        <span>Medical Records</span>
                    </a>
                    <a class="sidebar-nav-link @(currentController == "Operations" ? "active" : "")" asp-controller="Operations" asp-action="Index">
                        <i class="bi bi-heart-pulse"></i>
                        <span>Operations / OT</span>
                    </a>

                    <div class="nav-section-title mt-2">Patients</div>
                    <a class="sidebar-nav-link @(currentController == "Patients" ? "active" : "")" asp-controller="Patients" asp-action="Index">
                        <i class="bi bi-people"></i>
                        <span>Patient Directory</span>
                    </a>
                }
                else if (User.IsInRole("Assistant"))
                {
                    <div class="nav-section-title">Workflow</div>
                    <a class="sidebar-nav-link @(currentController == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-speedometer2"></i>
                        <span>Dashboard</span>
                    </a>
                    <a class="sidebar-nav-link @(currentController == "Appointments" ? "active" : "")" asp-controller="Appointments" asp-action="Index">
                        <i class="bi bi-calendar2-check"></i>
                        <span>Consultations</span>
                    </a>
                }
                else if (User.IsInRole("Pharmacist"))
                {
                    <div class="nav-section-title">Pharmacy</div>
                    <a class="sidebar-nav-link @(currentController == "Prescriptions" ? "active" : "")" asp-controller="Prescriptions" asp-action="Index">
                        <i class="bi bi-file-earmark-medical"></i>
                        <span>Prescriptions</span>
                    </a>
                    <a class="sidebar-nav-link @(currentController == "Medicines" ? "active" : "")" asp-controller="Medicines" asp-action="Index">
                        <i class="bi bi-capsule"></i>
                        <span>Drug Inventory</span>
                    </a>
                }
                else if (User.IsInRole("Receptionist"))
                {
                    <div class="nav-section-title">Front Desk</div>
                    <a class="sidebar-nav-link @(currentController == "Reception" ? "active" : "")" asp-controller="Reception" asp-action="Index">
                        <i class="bi bi-front"></i>
                        <span>Front Desk & Triage</span>
                    </a>
                    <a class="sidebar-nav-link @(currentController == "Patients" ? "active" : "")" asp-controller="Patients" asp-action="Index">
                        <i class="bi bi-people"></i>
                        <span>Patient Registry</span>
                    </a>
                    <a class="sidebar-nav-link @(currentController == "Appointments" ? "active" : "")" asp-controller="Appointments" asp-action="Index">
                        <i class="bi bi-calendar-event"></i>
                        <span>Appointments</span>
                    </a>

                    <div class="nav-section-title mt-2">Inpatient & Surgery</div>
                    <a class="sidebar-nav-link @(currentController == "Admissions" ? "active" : "")" asp-controller="Admissions" asp-action="Index">
                        <i class="bi bi-door-open"></i>
                        <span>Admissions</span>
                    </a>
                    <a class="sidebar-nav-link @(currentController == "Beds" ? "active" : "")" asp-controller="Beds" asp-action="Index">
                        <i class="bi bi-hospital"></i>
                        <span>Ward Beds</span>
                    </a>
                    <a class="sidebar-nav-link @(currentController == "Operations" ? "active" : "")" asp-controller="Operations" asp-action="Index">
                        <i class="bi bi-heart-pulse"></i>
                        <span>Operations / OT</span>
                    </a>

                    <div class="nav-section-title mt-2">Finance</div>
                    <a class="sidebar-nav-link @(currentController == "Bills" ? "active" : "")" asp-controller="Bills" asp-action="Index">
                        <i class="bi bi-receipt"></i>
                        <span>Bills & Cashier</span>
                    </a>
                }
                else if (User.IsInRole("Admin"))
                {
                    <div class="nav-section-title">Overview</div>
                    <a class="sidebar-nav-link @(currentController == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-speedometer2"></i>
                        <span>Dashboard</span>
                    </a>
                    <a class="sidebar-nav-link @(currentController == "Reports" ? "active" : "")" asp-controller="Reports" asp-action="Index">
                        <i class="bi bi-bar-chart-line"></i>
                        <span>Audit & Reports</span>
                    </a>

                    <div class="nav-section-title mt-2">Hospital Operations</div>
                    <a class="sidebar-nav-link @(currentController == "Patients" ? "active" : "")" asp-controller="Patients" asp-action="Index">
                        <i class="bi bi-people"></i>
                        <span>Patients</span>
                    </a>
                    <a class="sidebar-nav-link @(currentController == "Appointments" ? "active" : "")" asp-controller="Appointments" asp-action="Index">
                        <i class="bi bi-calendar2-check"></i>
                        <span>Appointments</span>
                    </a>
                    <a class="sidebar-nav-link @(currentController == "Admissions" ? "active" : "")" asp-controller="Admissions" asp-action="Index">
                        <i class="bi bi-door-open"></i>
                        <span>Admissions</span>
                    </a>
                    <a class="sidebar-nav-link @(currentController == "Beds" ? "active" : "")" asp-controller="Beds" asp-action="Index">
                        <i class="bi bi-hospital"></i>
                        <span>Bed Allocation</span>
                    </a>
                    <a class="sidebar-nav-link @(currentController == "Operations" ? "active" : "")" asp-controller="Operations" asp-action="Index">
                        <i class="bi bi-heart-pulse"></i>
                        <span>Operations</span>
                    </a>

                    <div class="nav-section-title mt-2">Pharmacy & Billing</div>
                    <a class="sidebar-nav-link @(currentController == "Medicines" ? "active" : "")" asp-controller="Medicines" asp-action="Index">
                        <i class="bi bi-capsule"></i>
                        <span>Medicines</span>
                    </a>
                    <a class="sidebar-nav-link @(currentController == "Bills" ? "active" : "")" asp-controller="Bills" asp-action="Index">
                        <i class="bi bi-receipt"></i>
                        <span>Billing</span>
                    </a>

                    <div class="nav-section-title mt-2">Administration</div>
                    <a class="sidebar-nav-link @(currentController == "Staff" ? "active" : "")" asp-controller="Staff" asp-action="Index">
                        <i class="bi bi-person-workspace"></i>
                        <span>Staff Directory</span>
                    </a>
                    <a class="sidebar-nav-link @(currentController == "AiProviderSettings" ? "active" : "")" asp-controller="AiProviderSettings" asp-action="Index">
                        <i class="bi bi-cpu"></i>
                        <span>AI Providers</span>
                    </a>
                }
                else if (User.IsInRole("Patient"))
                {
                    <div class="nav-section-title">My Health Portal</div>
                    <a class="sidebar-nav-link @(currentController == "Portal" && currentAction == "Index" ? "active" : "")" asp-controller="Portal" asp-action="Index">
                        <i class="bi bi-calendar2-check"></i>
                        <span>My Appointments</span>
                    </a>
                    <a class="sidebar-nav-link @(currentController == "Portal" && currentAction == "Book" ? "active" : "")" asp-controller="Portal" asp-action="Book">
                        <i class="bi bi-calendar-plus text-primary"></i>
                        <span class="fw-medium">Book Visit</span>
                    </a>
                    <a class="sidebar-nav-link @(currentController == "Portal" && currentAction == "Doctors" ? "active" : "")" asp-controller="Portal" asp-action="Doctors">
                        <i class="bi bi-search-heart"></i>
                        <span>Find Doctors</span>
                    </a>

                    <div class="nav-section-title mt-2">Clinical History</div>
                    <a class="sidebar-nav-link @(currentController == "Portal" && currentAction == "Records" ? "active" : "")" asp-controller="Portal" asp-action="Records">
                        <i class="bi bi-clipboard2-pulse"></i>
                        <span>Medical Records</span>
                    </a>
                    <a class="sidebar-nav-link @(currentController == "Portal" && currentAction == "Prescriptions" ? "active" : "")" asp-controller="Portal" asp-action="Prescriptions">
                        <i class="bi bi-file-earmark-medical"></i>
                        <span>Prescriptions</span>
                    </a>

                    <div class="nav-section-title mt-2">Billing & Account</div>
                    <a class="sidebar-nav-link @(currentController == "Portal" && currentAction == "Bills" ? "active" : "")" asp-controller="Portal" asp-action="Bills">
                        <i class="bi bi-receipt"></i>
                        <span>Invoices & Bills</span>
                    </a>

                    <div class="nav-section-title mt-2">Verification</div>
                    <a class="sidebar-nav-link @(currentController == "Verify" ? "active" : "")" asp-controller="Verify" asp-action="Prescription">
                        <i class="bi bi-patch-check"></i>
                        <span>Verify Rx QR</span>
                    </a>
                }
            </nav>
        </aside>

        <!-- Main Content Area -->
        <div class="staff-main-wrapper">
            <header class="staff-topbar">
                <div class="d-flex align-items-center gap-2">
                    <button type="button" id="sidebarToggleBtn" class="btn btn-sm btn-outline-secondary d-lg-none" aria-label="Toggle Navigation">
                        <i class="bi bi-list fs-5"></i>
                    </button>
                    @if (isPatient)
                    {
                        <div class="d-flex align-items-center gap-2">
                            <div class="quick-jump-box d-none d-md-flex">
                                <i class="bi bi-search search-icon"></i>
                                <input type="text" id="quickDoctorSearchInput" class="quick-jump-input font-mono-data" placeholder="Search doctor or specialty..." autocomplete="off">
                                <kbd class="shortcut-kbd"><span class="cmd-icon">Ctrl</span> K</kbd>
                            </div>
                            @if (ViewBag.Dependents is List<HospitalManagementSystem.Models.Patient> dependents && dependents.Any())
                            {
                                var activePatient = ViewBag.Patient as HospitalManagementSystem.Models.Patient;
                                var primaryPatient = ViewBag.PrimaryPatient as HospitalManagementSystem.Models.Patient;
                                var isChildActive = activePatient?.Id != primaryPatient?.Id;

                                <div class="family-pill-bar ms-1">
                                    <form asp-controller="Portal" asp-action="SwitchProfile" method="post" class="m-0">
                                        <input type="hidden" name="patientId" value="@primaryPatient?.Id" />
                                        <button type="submit" class="family-pill @(!isChildActive ? "active" : "")" title="Switch to @primaryPatient?.FullName (You)">
                                            <i class="bi bi-person-fill"></i>
                                            <span class="family-pill-name">@(primaryPatient?.FullName ?? "You")</span>
                                        </button>
                                    </form>
                                    <div class="dropdown d-inline-flex">
                                        <button class="family-pill dropdown-toggle @(isChildActive ? "active child-active" : "")" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Switch Patient Profile">
                                            <i class="bi bi-people-fill"></i>
                                            <span class="family-pill-name">@(isChildActive ? activePatient?.FullName : "Family (" + dependents.Count + ")")</span>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-start shadow border-0 py-2" style="min-width: 250px;">
                                            <li class="dropdown-header text-uppercase fs-8 fw-bold text-muted px-3">Switch Patient Profile</li>
                                            @foreach (var dep in dependents)
                                            {
                                                var isThisActive = activePatient?.Id == dep.Id;
                                                <li>
                                                    <form asp-controller="Portal" asp-action="SwitchProfile" method="post" class="m-0">
                                                        <input type="hidden" name="patientId" value="@dep.Id" />
                                                        <button type="submit" class="dropdown-item py-2 px-3 d-flex align-items-center justify-content-between @(isThisActive ? "active fw-bold" : "")">
                                                            <div class="d-flex align-items-center gap-2">
                                                                <i class="bi bi-person-heart text-info"></i>
                                                                <div>
                                                                    <div>@dep.FullName</div>
                                                                    <small class="text-muted d-block font-mono-data">@dep.Uhid &bull; @(dep.GuardianRelationship ?? "Child")</small>
                                                                </div>
                                                            </div>
                                                            @if (isThisActive)
                                                            {
                                                                <i class="bi bi-check-lg text-primary ms-2"></i>
                                                            }
                                                        </button>
                                                    </form>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="quick-jump-box">
                            <i class="bi bi-search search-icon"></i>
                            <input type="text" id="quickPatientSearchInput" class="quick-jump-input font-mono-data" placeholder="Jump to patient UHID or name..." autocomplete="off">
                            <kbd class="shortcut-kbd"><span class="cmd-icon">Ctrl</span> K</kbd>
                        </div>
                    }
                </div>

                <div class="d-flex align-items-center gap-2 gap-sm-3">
                    @if (User.IsInRole("Doctor") || User.IsInRole("Assistant"))
                    {
                        <div id="signalrStatusIndicator" class="signalr-status d-none d-sm-flex align-items-center gap-1" title="Real-time Notification link">
                            <span class="signalr-dot"></span>
                            <span class="signalr-label">Offline</span>
                        </div>
                    }
                    <button type="button" id="themeToggleBtn" class="theme-toggle" title="Theme: auto">
                        <i class="bi bi-circle-half"></i>
                    </button>
                    <div class="d-flex align-items-center gap-2">
                        <div class="d-none d-md-block text-end" style="line-height: 1.2;">
                            <div class="fw-semibold text-strong" style="font-size: 0.8125rem;">@User.Identity.Name</div>
                            <small class="text-muted font-mono-data" style="font-size: 0.7rem;">@User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value</small>
                        </div>
                        <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                            <button type="submit" class="btn btn-sm btn-outline-danger px-2 py-1" title="Log Out">
                                <i class="bi bi-box-arrow-right"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </header>

            <main role="main" class="@(isFluid ? "staff-workspace-fluid" : "staff-workspace")">
                @RenderBody()
            </main>

            @if (!isFluid)
            {
                <footer class="staff-footer text-center">
                    <small>&copy; 2026 - Nexus Hospital Management System &bull; <a asp-controller="Home" asp-action="Privacy">Privacy Policy</a></small>
                </footer>
            }
        </div>
    </div>
}
else
{
    <!-- Public Guest Header (Unauthenticated) -->
    <header class="consumer-navbar sticky-top">
        <div class="container d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <a class="navbar-brand d-flex align-items-center gap-2 mb-0" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-hospital"></i>
                    <span>Nexus Hospital</span>
                </a>
                <nav class="d-none d-md-flex align-items-center gap-2 ms-3">
                    <a class="nav-link @(currentController == "Portal" && currentAction == "Doctors" ? "active" : "")" asp-controller="Portal" asp-action="Doctors">Find Doctors</a>
                    <a class="nav-link @(currentController == "Verify" && currentAction == "Prescription" ? "active" : "")" asp-controller="Verify" asp-action="Prescription">
                        <i class="bi bi-patch-check me-1"></i>Verify Prescription
                    </a>
                </nav>
            </div>

            <div class="d-flex align-items-center gap-2">
                <button type="button" id="themeToggleBtn" class="theme-toggle" title="Theme: auto">
                    <i class="bi bi-circle-half"></i>
                </button>
                <a class="btn btn-sm btn-outline-secondary d-none d-sm-inline-flex" asp-controller="Verify" asp-action="Prescription">
                    <i class="bi bi-patch-check me-1"></i>Verify Rx
                </a>
                <a class="btn btn-sm btn-primary" asp-controller="Auth" asp-action="Login">Log In</a>
            </div>
        </div>
    </header>

    <div class="container py-3">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer text-center">
        <div class="container">
            <small>&copy; 2026 - Nexus Hospital Management System - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy Policy</a></small>
        </div>
    </footer>
}

    <!-- Global Toast Container -->
    <div class="toast-container position-fixed bottom-0 end-0 p-4" style="z-index: 1055;">
        <div id="notificationToast" class="toast border-0" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="10000">
            <div class="toast-header bg-success text-white border-0 py-2">
                <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                <strong class="me-auto fs-6">Consultation Completed!</strong>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="toast-body fs-6 p-3">
                <span id="notificationMessage"></span>
            </div>
        </div>
    </div>

    <!-- Global Medical Record Quick-View Modal -->
    <partial name="_MedicalRecordQuickViewModal" />

    <!-- Audio for Ding -->
    <audio id="dingSound" src="https://www.soundjay.com/misc/sounds/bell-ringing-05.mp3" preload="auto"></audio>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.10.1/dist/sweetalert2.all.min.js"></script>
    <script>
        $(document).ready(function () {
            $(".datepicker").flatpickr({
                dateFormat: "Y-m-d",
                altInput: true,
                altFormat: "d/m/y",
                allowInput: true,
                disableMobile: "true",
                wrap: true
            });
        });
    </script>
    @if (User.IsInRole("Assistant") || User.IsInRole("Doctor"))
    {
        var assignedDoctorId = User.Claims.FirstOrDefault(c => c.Type == "AssignedDoctorId")?.Value;
        if (User.IsInRole("Doctor"))
        {
            assignedDoctorId = User.Claims.FirstOrDefault(c => c.Type == "UserId")?.Value;
            if (string.IsNullOrEmpty(assignedDoctorId))
            {
                var dbContext = Context.RequestServices.GetService(typeof(HospitalManagementSystem.Models.ApplicationDbContext)) as HospitalManagementSystem.Models.ApplicationDbContext;
                var docUser = dbContext?.Users.FirstOrDefault(u => u.FullName == User.Identity.Name);
                assignedDoctorId = docUser?.Id.ToString();
            }
        }
        <script>
            window.MySignalRGroupId = "@assignedDoctorId";
            window.UserRole = "@(User.IsInRole("Doctor") ? "Doctor" : "Assistant")";
        </script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.12/signalr.min.js"></script>
        <script src="~/js/notifications.js" asp-append-version="true"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
