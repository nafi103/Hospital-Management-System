<!-- Medical Record Quick-View Modal -->
<div class="modal fade" id="medicalRecordQuickViewModal" tabindex="-1" aria-labelledby="medicalRecordQuickViewModalTitle" aria-hidden="true" style="z-index: 1065;">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content shadow-lg border-0 rounded-4 overflow-hidden" style="background-color: var(--surface-card);">
            <div class="modal-header py-2-5 px-3 px-md-4 bg-surface-raised border-bottom d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <span class="rounded-circle p-1 d-inline-flex align-items-center justify-content-center" style="width: 28px; height: 28px; background: rgba(59, 130, 246, 0.15); color: #3b82f6;">
                        <i class="bi bi-file-earmark-medical fs-6"></i>
                    </span>
                    <h6 class="modal-title fw-bold mb-0 text-strong" id="medicalRecordQuickViewModalTitle">Medical Record Source</h6>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <div id="citationNavControls" class="d-none align-items-center gap-1 border rounded px-2 py-0-5 bg-surface-sunken" style="font-size: 0.75rem;">
                        <button type="button" id="btnPrevCitation" class="btn btn-sm btn-link p-0 text-decoration-none text-muted" title="Previous reference" style="line-height: 1;">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        <span id="citationNavBadge" class="small text-muted font-mono-data px-1" style="font-size: 0.72rem;">1 / 1</span>
                        <button type="button" id="btnNextCitation" class="btn btn-sm btn-link p-0 text-decoration-none text-muted" title="Next reference" style="line-height: 1;">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                    <a id="btnModalOpenRecordFull" href="#" target="_blank" class="btn btn-outline-secondary btn-sm py-1 px-2 d-none d-sm-inline-flex align-items-center gap-1" title="Open record in a separate browser tab" style="font-size: 0.75rem;">
                        <i class="bi bi-box-arrow-up-right"></i>
                        <span>New Tab</span>
                    </a>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
            </div>
            <div class="modal-body p-0" id="medicalRecordQuickViewModalContent">
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading record...</span>
                    </div>
                    <p class="text-muted mt-2 small mb-0">Loading clinical record details...</p>
                </div>
            </div>
            <div class="modal-footer py-2 px-3 px-md-4 bg-surface-sunken border-top d-flex justify-content-between align-items-center">
                <span class="small text-muted d-flex align-items-center gap-1" style="font-size: 0.75rem;">
                    <i class="bi bi-shield-check text-success"></i>
                    <span>Consultation notes &amp; inputs remain safely preserved in the background.</span>
                </span>
                <button type="button" class="btn btn-secondary btn-sm px-3" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
